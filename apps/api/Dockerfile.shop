FROM node:22-alpine AS base
# Préparer pnpm au build (image offline-capable ; runtime n'utilise plus pnpm pour migrate)
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @caisse-crm/shared build
RUN pnpm --filter api exec prisma generate
RUN pnpm --filter api build

FROM base AS runtime
ENV NODE_ENV=production
RUN apk add --no-cache wget \
  && addgroup -S app && adduser -S -G app app
WORKDIR /repo
COPY --from=build /repo /repo
RUN chmod +x apps/api/docker-entrypoint-shop.sh \
  && chown -R app:app /repo
USER app
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=30s \
  CMD wget -qO- http://127.0.0.1:3001/health >/dev/null || exit 1
ENTRYPOINT ["apps/api/docker-entrypoint-shop.sh"]
