  ecritureComptable    EcritureComptable?              @relation(fields: [ecritureComptableId], references: [id])
  ecritureComptableId  String?                         @unique
  montant              Decimal                         @db.Decimal(14, 2)
  montantDevise        Decimal?                        @db.Decimal(14, 2)
  devise               String                          @default("XOF")
  tauxChangeSnapshot   Decimal?                        @db.Decimal(18, 6)
  mode                 ModePaiementFournisseur
  reference            String?
  clientOperationId    String?                         @unique
  datePaiement         DateTime                        @default(now())
  utilisateur          Utilisateur                     @relation(fields: [utilisateurId], references: [id])
  utilisateurId        String
  allocations          AllocationPaiementFournisseur[]
  mouvementsTresorerie MouvementTresorerie[]
  rapprochements       RapprochementBancaire[]

  @@index([factureId, datePaiement])
  @@map("paiement_fournisseur")
}

enum TypeTaxeAchat {
