  @@index([factureId, dateDecision])
  @@map("exception_rapprochement_facture")
}

model RevueExtractionFacture {
  id                String             @id @default(uuid())
  facture           FactureFournisseur @relation(fields: [factureId], references: [id])
  factureId         String
  auteur            Utilisateur        @relation("RevueExtractionFactureAuteur", fields: [auteurId], references: [id])
  auteurId          String
  decision          String
  commentaire       String?
  payloadRevise     Json?
  dateRevue         DateTime           @default(now())
  clientOperationId String             @unique

  @@index([factureId, dateRevue])
  @@map("revue_extraction_facture")
}

// Grand livre append-only des règlements fournisseur — aucune modification
// ni suppression d'une ligne déjà enregistrée (même esprit que JournalAudit).
model PaiementFournisseur {
  id                   String                          @id @default(uuid())
  facture              FactureFournisseur              @relation(fields: [factureId], references: [id])
  factureId            String
