// Schéma Prisma — Progiciel Caisses & CRM
// Référence : Cahier_des_charges_Caisses_CRM.docx §6.5 (Modèle Conceptuel de Données)
// Toute modification de ce fichier doit rester traçable à une section du cahier des charges.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organisation (§3, §4)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Entreprise — fiche société mono-tenant (paramètres légaux / devise).
// ---------------------------------------------------------------------------

model Societe {
  id                              String   @id @default(uuid())
  raisonSociale                   String
  adresse                         String
  telephone                       String?
  email                           String?
  devise                          String   @default("XOF")
  logoUrl                         String?
  // Montant (FCFA) au-delà duquel seul la Direction Générale peut valider
  // un rapprochement sans écart (§4 « validation seuils exceptionnels »).
  seuilValidationDg               Decimal  @default(5000000) @db.Decimal(14, 2)
  // Délai (heures) au-delà duquel un versement non transmis déclenche une
  // alerte et est compté en retard dans le reporting DAF (§6.3.5 « gestion
  // des seuils : montants de versement, délais »).
  delaiVersementHeures            Int      @default(24)
  // Seuils CRM paramétrables (§6.6) — défauts = première itération documentée.
  seuilFideliteArgent             Int      @default(500)
  seuilFideliteOr                 Int      @default(2000)
  seuilSegmentRegulier            Int      @default(5)
  seuilSegmentVip                 Int      @default(15)
  // Avantages fidélité (§6.6 « avantages associés ») : remise % appliquée
  // automatiquement à l'encaissement pour un client aux paliers Argent/Or.
  // Défaut 0 = désactivé — le cahier ne chiffre pas ces avantages, c'est à
  // l'admin de les activer et de les chiffrer (comme les autres seuils).
  avantageFideliteArgentPct       Int      @default(0)
  avantageFideliteOrPct           Int      @default(0)
  // Seuil de caisse (§5.1 « par exemple 500 000 FCFA ») au-delà duquel une
  // alerte de versement anticipé est déclenchée en cours de journée. Null =
  // désactivé (le cahier ne donne qu'un exemple, pas une valeur imposée).
  seuilVersementAnticipe          Decimal? @db.Decimal(14, 2)
  // Délai (heures) de régularisation d'un litige avant alerte de retard
  // (§5.1 « sous 24 à 48 heures » — 48h = borne haute retenue par défaut).
  delaiRegularisationLitigeHeures Int      @default(48)

  @@map("societe")
}

model Zone {
  id        String     @id @default(uuid())
  nomZone   String
  boutiques Boutique[]

  @@map("zone")
}

model Boutique {
  id             String          @id @default(uuid())
  nom            String
  adresse        String
  code           String?
  actif          Boolean         @default(true)
  zone           Zone            @relation(fields: [zoneId], references: [id])
  zoneId         String
  caisses        Caisse[]
  utilisateurs   Utilisateur[]
  entrepots      Entrepot[]
  commandesAchat CommandeAchat[]
  clientsOrigine Client[]
  devisClients   DevisClient[]

  @@map("boutique")
}

enum TypeEntrepot {
  PRINCIPAL
  SECONDAIRE
}

enum UsageEmplacement {
  STOCK
  ENTREE
  SORTIE
  PERTE
  FOURNISSEUR
  CLIENT
}

// Emplacement de stock rattaché à une boutique. Chaque boutique a au moins
// un entrepôt PRINCIPAL (consommé par le POS de la boutique).
model Entrepot {
  id                 String              @id @default(uuid())
  nom                String
  code               String
  type               TypeEntrepot        @default(PRINCIPAL)
  usage              UsageEmplacement    @default(STOCK)
  reseau             Boolean             @default(false)
  virtuel            Boolean             @default(false)
  actif              Boolean             @default(true)
  boutique           Boutique            @relation(fields: [boutiqueId], references: [id])
  boutiqueId         String
  quants             StockQuant[]
  mouvements         MouvementStock[]
  sessionsInventaire SessionInventaire[]
  receptions         ReceptionStock[]
  reservations       ReservationStock[]
  stockLots          StockLot[]
  bonsSource         BonStock[]          @relation("BonStockSource")
  bonsDest           BonStock[]          @relation("BonStockDest")
  reglesReappro      RegleReappro[]

  @@unique([boutiqueId, code])
  @@index([reseau, usage])
  @@map("entrepot")
}

// ---------------------------------------------------------------------------
// Utilisateurs et rôles (§4, §6.2)
// ---------------------------------------------------------------------------

model Role {
  id                 String        @id @default(uuid())
  libelle            String        @unique
  niveauHabilitation Int
  utilisateurs       Utilisateur[]

  @@map("role")
}

model Utilisateur {
  id           String    @id @default(uuid())
  nom          String
  prenom       String
  login        String    @unique
  passwordHash String
  role         Role      @relation(fields: [roleId], references: [id])
  roleId       String
  // Périmètre de données : null pour les profils à vue consolidée réseau
  // (Direction Générale, DAF, Caissier Central, Contrôle interne — §6.2)
  boutique     Boutique? @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // Contact pour les notifications proactives (§6.7, §5.1) : optionnel,
  // aucune valeur par défaut inventée — sans contact renseigné, l'utilisateur
  // ne reçoit que la diffusion temps réel (WebSocket), pas de SMS/email.
  email     String?
  telephone String?

  // Sécurité authentification (§6.7)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  transactionsInitiees    TransactionCaisse[]    @relation("Initiateur")
  receptionsValidees      ReceptionValidation[]  @relation("Validateur")
  regularisationsValidees RegularisationLitige[] @relation("ValidateurRegularisation")
  entreesAudit            JournalAudit[]

  sessionsOuvertes           SessionCaisse[]       @relation("OuvertureSession")
  sessionsTemoinOuverture    SessionCaisse[]       @relation("OuvertureTemoin")
  sessionsFermees            SessionCaisse[]       @relation("ClotureSession")
  sessionsTemoinCloture      SessionCaisse[]       @relation("ClotureTemoin")
  receptionsStock            ReceptionStock[]
  mouvementsStock            MouvementStock[]
  retoursVente               RetourVente[]
  campagnesCreees            CampagneCrm[]
  devisClientsCrees          DevisClient[]
  sessionsInventaireInitiees SessionInventaire[]   @relation("InventaireInitiateur")
  sessionsInventaireValidees SessionInventaire[]   @relation("InventaireValidateur")
  commandesAchatInitiees     CommandeAchat[]       @relation("CommandeAchatInitiateur")
  facturesFournisseur        FactureFournisseur[]
  paiementsFournisseur       PaiementFournisseur[]
  bonsStockInitiees          BonStock[]            @relation("BonStockInitiateur")
  lotsCrees                  Lot[]

  @@map("utilisateur")
}

// ---------------------------------------------------------------------------
// Caisses et trésorerie (§6.3.1, §6.4)
// ---------------------------------------------------------------------------

// Grande surface : TIROIR (poste POS) → MAGASIN (cash office) → CENTRALE.
enum TypeCaisse {
  TIROIR
  MAGASIN
  CENTRALE
}

model Caisse {
  id             String     @id @default(uuid())
  type           TypeCaisse
  // Colonne de cache en lecture seule : recalculée exclusivement à partir du
  // journal des TransactionCaisse (grand livre append-only — voir CLAUDE.md).
  // Ne jamais écrire directement via UPDATE ; toujours passer par le service
  // de recalcul du solde.
  soldeCourant   Decimal    @default(0) @db.Decimal(14, 2)
  boutique       Boutique?  @relation(fields: [boutiqueId], references: [id])
  boutiqueId     String?
  // Config tiroirs (DAF) — null pour MAGASIN / CENTRALE.
  code           String?
  libelle        String?
  actif          Boolean    @default(true)
  ordreAffichage Int        @default(0)

  transactions TransactionCaisse[]
  ventes       Vente[]
  sessions     SessionCaisse[]

  @@unique([boutiqueId, code])
  @@index([boutiqueId, type])
  @@map("caisse")
}

enum TypeTransaction {
  VENTE
  SORTIE_FONDS
  // Transfert tiroir ↔ magasin (hors circuit convoyeur §6.4).
  TRANSFERT_INTERNE
}

// Machine à états stricte — §6.4 du cahier des charges.
// INITIEE -> EN_TRANSIT -> RECEPTIONNEE -> VALIDEE
//                                       -> LITIGE -> VALIDEE (régularisation)
enum StatutTransaction {
  INITIEE
  EN_TRANSIT
  RECEPTIONNEE
  VALIDEE
  LITIGE
}

model TransactionCaisse {
  id           String            @id @default(uuid())
  type         TypeTransaction
  montant      Decimal           @db.Decimal(14, 2)
  dateHeure    DateTime          @default(now())
  statut       StatutTransaction @default(INITIEE)
  caisse       Caisse            @relation(fields: [caisseId], references: [id])
  caisseId     String
  initiateur   Utilisateur       @relation("Initiateur", fields: [initiateurId], references: [id])
  initiateurId String

  // Contrepartie miroir : SORTIE_FONDS → CENTRALE, ou TRANSFERT_INTERNE
  // tiroir ↔ magasin. Unique : une seule contrepartie par source.
  transactionSource   TransactionCaisse?  @relation("ContrepartieCentrale", fields: [transactionSourceId], references: [id])
  transactionSourceId String?             @unique
  contreparties       TransactionCaisse[] @relation("ContrepartieCentrale")

  // Clé d'idempotence pour le mode hors-ligne (§6.7) : une opération
  // rejouée à la reconnexion ne crée pas de doublon.
  clientOperationId String? @unique

  bordereau      BordereauVersement?
  sessionCaisse  SessionCaisse?
  regularisation RegularisationLitige?

  @@index([caisseId])
  @@index([statut])
  @@map("transaction_caisse")
}

model BordereauVersement {
  id             String            @id @default(uuid())
  transaction    TransactionCaisse @relation(fields: [transactionId], references: [id])
  transactionId  String            @unique
  montantDeclare Decimal           @db.Decimal(14, 2)
  dateEmission   DateTime          @default(now())
  pieceJointe    String?

  reception ReceptionValidation?

  @@map("bordereau_versement")
}

model ReceptionValidation {
  id            String             @id @default(uuid())
  bordereau     BordereauVersement @relation(fields: [bordereauId], references: [id])
  bordereauId   String             @unique
  montantRecu   Decimal            @db.Decimal(14, 2)
  ecart         Decimal            @db.Decimal(14, 2)
  statutFinal   StatutTransaction
  validateur    Utilisateur        @relation("Validateur", fields: [validateurId], references: [id])
  validateurId  String
  dateReception DateTime           @default(now())

  @@map("reception_validation")
}

// Écriture compensatoire d'une régularisation de LITIGE (§6.4). Ne modifie
// jamais la TransactionCaisse ni la ReceptionValidation d'origine — le
// montant déclaré/constaté reste un fait historique immuable, seule cette
// table trace la décision d'arbitrage (montant retenu, motif, validateur).
model RegularisationLitige {
  id                 String            @id @default(uuid())
  transaction        TransactionCaisse @relation(fields: [transactionId], references: [id])
  transactionId      String            @unique
  montantRetenu      Decimal           @db.Decimal(14, 2)
  motif              String
  validateur         Utilisateur       @relation("ValidateurRegularisation", fields: [validateurId], references: [id])
  validateurId       String
  dateRegularisation DateTime          @default(now())

  @@map("regularisation_litige")
}

// ---------------------------------------------------------------------------
// Ventes / Point de vente boutique (§6.3.2, §5.1)
// ---------------------------------------------------------------------------

model Produit {
  id                  String               @id @default(uuid())
  designation         String
  // Référence interne / SKU — unique si renseignée (NULL autorisé plusieurs
  // fois). Sert au POS et à la recherche catalogue (§6.3.2).
  reference           String?              @unique
  // Classification libre (Protection, Charge, Audio…) — pas d'enum figé :
  // le cahier des charges ne prescrit pas de nomenclature.
  categorie           String?
  description         String?
  // Photo catalogue (data URL compressée ou URL). Optionnelle — le POS et
  // la fiche affichent les initiales si absente.
  imageUrl            String?
  // Désactivation sans suppression : l'historique des ventes reste intact
  // (cohérent avec le grand livre append-only). Un produit inactif ne peut
  // plus être encaissé et n'alimente plus l'alerte STOCK_BAS.
  actif               Boolean              @default(true)
  // Article physique (stock décrémenté à la vente) ou prestation de service
  // (§6.3.1 « produits ou prestations... gestion de stock simplifiée si
  // nécessaire ») : une PRESTATION n'a pas de décrément/contrôle de stock.
  typeProduit         TypeProduit          @default(ARTICLE)
  prixUnitaire        Decimal              @db.Decimal(14, 2)
  // Cache réseau = somme(StockQuant.quantite). Ne jamais écrire à la
  // main — passer par StockService.
  stock               Int                  @default(0)
  // Coût moyen pondéré (CMP) — recalculé à chaque réception fournisseur
  // (apps/api/src/fournisseurs/fournisseurs.service.ts). Sert de base à la
  // valorisation du stock (§ extension audit modules Odoo/QuickBooks).
  coutMoyenPondere    Decimal              @default(0) @db.Decimal(14, 2)
  // Seuil de réapprovisionnement optionnel : déclenche l'alerte STOCK_BAS
  // (apps/api/src/alertes/alertes.service.ts) quand stock <= seuilReappro.
  seuilReappro        Int?
  codeBarres          String?              @unique
  uniteMesure         String               @default("UN")
  facteurUnite        Decimal              @default(1) @db.Decimal(12, 4)
  parentId            String?
  parent              Produit?             @relation("VarianteProduit", fields: [parentId], references: [id])
  variantes           Produit[]            @relation("VarianteProduit")
  attributs           String?
  methodeCout         MethodeCout          @default(CMP)
  coutStandard        Decimal              @default(0) @db.Decimal(14, 2)
  strategieSortie     StrategieSortie      @default(FIFO)
  lignesVente         LigneVente[]
  lignesDevis         LigneDevisClient[]
  receptions          ReceptionStock[]
  mouvements          MouvementStock[]
  quants              StockQuant[]
  lignesInventaire    LigneInventaire[]
  lignesCommandeAchat LigneCommandeAchat[]
  reservations        ReservationStock[]
  lots                Lot[]
  stockLots           StockLot[]
  lignesBonStock      LigneBonStock[]
  reglesReappro       RegleReappro[]
  coutsLogistiques    CoutLogistique[]

  @@index([categorie])
  @@index([actif])
  @@map("produit")
}

// Grand livre append-only des mouvements de stock — même principe que
// TransactionCaisse pour la trésorerie (voir CLAUDE.md) : Produit.stock est
// un cache rapide, MouvementStock est la source de vérité auditable.
enum MethodeCout {
  CMP
  FIFO
  STANDARD
}

enum TypeProduit {
  ARTICLE
  PRESTATION
}

enum StrategieSortie {
  FIFO
  FEFO
}

enum TypeMouvementStock {
  RECEPTION
  VENTE
  RETOUR
  AJUSTEMENT
  TRANSFERT_OUT
  TRANSFERT_IN
  SCRAP
}

model MouvementStock {
  id            String             @id @default(uuid())
  produit       Produit            @relation(fields: [produitId], references: [id])
  produitId     String
  entrepot      Entrepot?          @relation(fields: [entrepotId], references: [id])
  // Nullable pour rétrocompatibilité des mouvements historiques (pré multi-emplacement).
  entrepotId    String?
  type          TypeMouvementStock
  // Signé : positif = entrée, négatif = sortie (sur l'entrepôt ciblé)
  quantite      Int
  // Quantité du StockQuant après mouvement (pas le cache réseau Produit.stock)
  stockApres    Int
  reference     String?
  lot           Lot?               @relation(fields: [lotId], references: [id])
  lotId         String?
  dateHeure     DateTime           @default(now())
  utilisateur   Utilisateur        @relation(fields: [utilisateurId], references: [id])
  utilisateurId String

  @@index([entrepotId, produitId])
  @@map("mouvement_stock")
}

// Quantité source de vérité par emplacement. Produit.stock = somme des quants
// (cache réseau recalculé, jamais écrit à la main).
model StockQuant {
  id           String   @id @default(uuid())
  produit      Produit  @relation(fields: [produitId], references: [id])
  produitId    String
  entrepot     Entrepot @relation(fields: [entrepotId], references: [id])
  entrepotId   String
  quantite     Int      @default(0)
  consignation Boolean  @default(false)

  @@unique([produitId, entrepotId])
  @@map("stock_quant")
}

model Lot {
  id             String           @id @default(uuid())
  produit        Produit          @relation(fields: [produitId], references: [id])
  produitId      String
  numero         String
  dateExpiration DateTime?
  createur       Utilisateur      @relation(fields: [createurId], references: [id])
  createurId     String
  createdAt      DateTime         @default(now())
  stockLots      StockLot[]
  mouvements     MouvementStock[]
  lignesBon      LigneBonStock[]

  @@unique([produitId, numero])
  @@map("lot")
}

model StockLot {
  id         String   @id @default(uuid())
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  String
  entrepot   Entrepot @relation(fields: [entrepotId], references: [id])
  entrepotId String
  lot        Lot      @relation(fields: [lotId], references: [id])
  lotId      String
  quantite   Int      @default(0)

  @@unique([produitId, entrepotId, lotId])
  @@map("stock_lot")
}

enum TypeOperationStock {
  RECEPTION
  LIVRAISON
  TRANSFERT_INTERNE
  REBUT
}

enum StatutBonStock {
  BROUILLON
  PRET
  FAIT
  ANNULE
}

model BonStock {
  id               String             @id @default(uuid())
  numero           String             @unique
  type             TypeOperationStock
  statut           StatutBonStock     @default(BROUILLON)
  entrepotSource   Entrepot?          @relation("BonStockSource", fields: [entrepotSourceId], references: [id])
  entrepotSourceId String?
  entrepotDest     Entrepot?          @relation("BonStockDest", fields: [entrepotDestId], references: [id])
  entrepotDestId   String?
  notes            String?
  reception        ReceptionStock?    @relation(fields: [receptionId], references: [id])
  receptionId      String?
  initiateur       Utilisateur        @relation("BonStockInitiateur", fields: [initiateurId], references: [id])
  initiateurId     String
  dateCreation     DateTime           @default(now())
  datePret         DateTime?
  dateFait         DateTime?
  lignes           LigneBonStock[]

  @@index([statut, type])
  @@map("bon_stock")
}

model LigneBonStock {
  id             String    @id @default(uuid())
  bon            BonStock  @relation(fields: [bonId], references: [id])
  bonId          String
  produit        Produit   @relation(fields: [produitId], references: [id])
  produitId      String
  quantite       Int
  quantiteOk     Int?
  quantiteRebut  Int?
  lot            Lot?      @relation(fields: [lotId], references: [id])
  lotId          String?
  numeroLot      String?
  dateExpiration DateTime?

  @@map("ligne_bon_stock")
}

model RegleReappro {
  id         String   @id @default(uuid())
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  String
  entrepot   Entrepot @relation(fields: [entrepotId], references: [id])
  entrepotId String
  min        Int
  max        Int

  @@unique([produitId, entrepotId])
  @@map("regle_reappro")
}

model CoutLogistique {
  id            String          @id @default(uuid())
  produit       Produit         @relation(fields: [produitId], references: [id])
  produitId     String
  reception     ReceptionStock? @relation(fields: [receptionId], references: [id])
  receptionId   String?
  libelle       String
  montant       Decimal         @db.Decimal(14, 2)
  date          DateTime        @default(now())
  utilisateurId String

  @@index([produitId])
  @@map("cout_logistique")
}

// Inventaire physique — extension stock avancé (§6.5) pour la sécurité du
// stock : le comptage ne modifie pas StockQuant. Seule la validation par un
// autre utilisateur applique des AJUSTEMENT au grand livre (séparation des
// tâches, même esprit que le témoin de session de caisse §5.1).
enum StatutInventaire {
  EN_COURS
  VALIDE
  ANNULE
}

model SessionInventaire {
  id             String            @id @default(uuid())
  entrepot       Entrepot          @relation(fields: [entrepotId], references: [id])
  entrepotId     String
  statut         StatutInventaire  @default(EN_COURS)
  motif          String?
  dateOuverture  DateTime          @default(now())
  dateValidation DateTime?
  initiateur     Utilisateur       @relation("InventaireInitiateur", fields: [initiateurId], references: [id])
  initiateurId   String
  validateur     Utilisateur?      @relation("InventaireValidateur", fields: [validateurId], references: [id])
  validateurId   String?
  lignes         LigneInventaire[]

  @@index([entrepotId, statut])
  @@map("session_inventaire")
}

model LigneInventaire {
  id                String            @id @default(uuid())
  session           SessionInventaire @relation(fields: [sessionId], references: [id])
  sessionId         String
  produit           Produit           @relation(fields: [produitId], references: [id])
  produitId         String
  quantiteTheorique Int
  quantiteComptee   Int?
  dateComptage      DateTime?

  @@unique([sessionId, produitId])
  @@map("ligne_inventaire")
}

// ---------------------------------------------------------------------------
// Fournisseurs & approvisionnement — extension au socle MCD (§6.5), cycle
// complet validé avec l'utilisateur : fiche → bon de commande → réception
// → facture → paiement. Les paiements n'écrivent PAS dans TRANSACTION_CAISSE
// (§6.4, circuit versements boutique / caisse centrale).
// ---------------------------------------------------------------------------

enum StatutCommandeAchat {
  BROUILLON
  CONFIRMEE
  PARTIELLEMENT_RECEPTIONNEE
  RECEPTIONNEE
  CLOTUREE
  ANNULEE
}

enum StatutFactureFournisseur {
  BROUILLON
  COMPTABILISEE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum ModePaiementFournisseur {
  VIREMENT
  ESPECES
  MOBILE_MONEY
}

model Fournisseur {
  id         String               @id @default(uuid())
  nom        String
  contact    String?
  telephone  String?
  email      String?
  adresse    String?
  notes      String?
  actif      Boolean              @default(true)
  createdAt  DateTime             @default(now())
  receptions ReceptionStock[]
  commandes  CommandeAchat[]
  factures   FactureFournisseur[]

  @@index([actif])
  @@map("fournisseur")
}

model CommandeAchat {
  id               String               @id @default(uuid())
  numero           String               @unique
  fournisseur      Fournisseur          @relation(fields: [fournisseurId], references: [id])
  fournisseurId    String
  statut           StatutCommandeAchat  @default(BROUILLON)
  notes            String?
  dateCommande     DateTime             @default(now())
  dateConfirmation DateTime?
  dateCloture      DateTime?
  initiateur       Utilisateur          @relation("CommandeAchatInitiateur", fields: [initiateurId], references: [id])
  initiateurId     String
  boutique         Boutique?            @relation(fields: [boutiqueId], references: [id])
  boutiqueId       String?
  lignes           LigneCommandeAchat[]
  receptions       ReceptionStock[]

  @@index([fournisseurId, statut])
  @@map("commande_achat")
}

model LigneCommandeAchat {
  id           String           @id @default(uuid())
  commande     CommandeAchat    @relation(fields: [commandeId], references: [id])
  commandeId   String
  produit      Produit          @relation(fields: [produitId], references: [id])
  produitId    String
  quantite     Int
  prixUnitaire Decimal          @db.Decimal(14, 2)
  receptions   ReceptionStock[]

  @@unique([commandeId, produitId])
  @@map("ligne_commande_achat")
}

// Réception de stock : incrémente Produit.stock de façon atomique (même
// principe que le décrément lors d'une vente — voir ventes.service.ts).
model ReceptionStock {
  id               String                   @id @default(uuid())
  produit          Produit                  @relation(fields: [produitId], references: [id])
  produitId        String
  fournisseur      Fournisseur              @relation(fields: [fournisseurId], references: [id])
  fournisseurId    String
  quantite         Int
  // Prix d'achat unitaire réel — alimente le recalcul du coût moyen pondéré
  // (Produit.coutMoyenPondere) et l'historique des prix par fournisseur.
  prixAchat        Decimal                  @db.Decimal(14, 2)
  dateReception    DateTime                 @default(now())
  utilisateur      Utilisateur              @relation(fields: [utilisateurId], references: [id])
  utilisateurId    String
  // Emplacement réellement crédité (grand livre MouvementStock). Nullable
  // pour les réceptions historiques antérieures à ce suivi.
  entrepot         Entrepot?                @relation(fields: [entrepotId], references: [id])
  entrepotId       String?
  // Référence de livraison (BL).
  reference        String?
  commande         CommandeAchat?           @relation(fields: [commandeId], references: [id])
  commandeId       String?
  ligneCommande    LigneCommandeAchat?      @relation(fields: [ligneCommandeId], references: [id])
  ligneCommandeId  String?
  ligneFacture     LigneFactureFournisseur?
  bonsStock        BonStock[]
  coutsLogistiques CoutLogistique[]

  @@index([fournisseurId, dateReception])
  @@index([commandeId])
  @@map("reception_stock")
}

model FactureFournisseur {
  id                   String                    @id @default(uuid())
  numero               String                    @unique
  referenceFournisseur String?
  fournisseur          Fournisseur               @relation(fields: [fournisseurId], references: [id])
  fournisseurId        String
  statut               StatutFactureFournisseur  @default(BROUILLON)
  dateFacture          DateTime                  @default(now())
  dateEcheance         DateTime?
  notes                String?
  montant              Decimal                   @db.Decimal(14, 2)
  createur             Utilisateur               @relation(fields: [createurId], references: [id])
  createurId           String
  lignes               LigneFactureFournisseur[]
  paiements            PaiementFournisseur[]

  @@index([fournisseurId, statut])
  @@map("facture_fournisseur")
}

model LigneFactureFournisseur {
  id           String             @id @default(uuid())
  facture      FactureFournisseur @relation(fields: [factureId], references: [id])
  factureId    String
  reception    ReceptionStock     @relation(fields: [receptionId], references: [id])
  receptionId  String             @unique
  quantite     Int
  prixUnitaire Decimal            @db.Decimal(14, 2)

  @@map("ligne_facture_fournisseur")
}

// Grand livre append-only des règlements fournisseur — aucune modification
// ni suppression d'une ligne déjà enregistrée (même esprit que JournalAudit).
model PaiementFournisseur {
  id            String                  @id @default(uuid())
  facture       FactureFournisseur      @relation(fields: [factureId], references: [id])
  factureId     String
  montant       Decimal                 @db.Decimal(14, 2)
  mode          ModePaiementFournisseur
  reference     String?
  datePaiement  DateTime                @default(now())
  utilisateur   Utilisateur             @relation(fields: [utilisateurId], references: [id])
  utilisateurId String

  @@index([factureId, datePaiement])
  @@map("paiement_fournisseur")
}

enum ModePaiement {
  ESPECES
  CARTE
  MOBILE_MONEY
}

// Session de caisse (§5.1) : comptage contradictoire à l'ouverture et à la
// fermeture, période pendant laquelle les ventes s'accumulent. La clôture
// génère automatiquement UNE TransactionCaisse de type VENTE (montant =
// total des ventes ESPECES uniquement — seul mode de règlement qui transite
// physiquement par la caisse auxiliaire, cf. plan de la tâche) qui entre
// ensuite dans le circuit standard §6.4 (transit -> réception -> validation).
enum StatutSessionCaisse {
  OUVERTE
  FERMEE
}

model SessionCaisse {
  id                     String              @id @default(uuid())
  caisse                 Caisse              @relation(fields: [caisseId], references: [id])
  caisseId               String
  statut                 StatutSessionCaisse @default(OUVERTE)
  ouvertureDateHeure     DateTime            @default(now())
  fondInitial            Decimal             @db.Decimal(14, 2)
  ouvertureUtilisateur   Utilisateur         @relation("OuvertureSession", fields: [ouvertureUtilisateurId], references: [id])
  ouvertureUtilisateurId String
  // Comptage contradictoire (§5.1) : le témoin EST ré-authentifié par mot de
  // passe côté serveur (resoudreTemoin, bcrypt.compare réel) — pas une simplification.
  ouvertureTemoin        Utilisateur         @relation("OuvertureTemoin", fields: [ouvertureTemoinId], references: [id])
  ouvertureTemoinId      String
  clotureDateHeure       DateTime?
  fondCompteCloture      Decimal?            @db.Decimal(14, 2)
  clotureUtilisateur     Utilisateur?        @relation("ClotureSession", fields: [clotureUtilisateurId], references: [id])
  clotureUtilisateurId   String?
  clotureTemoin          Utilisateur?        @relation("ClotureTemoin", fields: [clotureTemoinId], references: [id])
  clotureTemoinId        String?
  transactionVersement   TransactionCaisse?  @relation(fields: [transactionVersementId], references: [id])
  transactionVersementId String?             @unique
  // Idempotence hors-ligne (§6.7) : UUID généré côté appareil, unique si renseigné.
  clientOperationId      String?             @unique
  ventes                 Vente[]
  retours                RetourVente[]
  reservations           ReservationStock[]
  ticketsAttente         TicketAttente[]

  @@map("session_caisse")
}

model Vente {
  id                String          @id @default(uuid())
  dateVente         DateTime        @default(now())
  montantTotal      Decimal         @db.Decimal(14, 2)
  // Avantage fidélité (§6.6) appliqué à l'encaissement, tracé séparément du
  // montant total (montantTotal est déjà net de cette remise).
  remiseFidelite    Decimal         @default(0) @db.Decimal(14, 2)
  modePaiement      ModePaiement
  caisse            Caisse          @relation(fields: [caisseId], references: [id])
  caisseId          String
  sessionCaisse     SessionCaisse   @relation(fields: [sessionCaisseId], references: [id])
  sessionCaisseId   String
  // Rattachement client optionnel — la vente anonyme doit rester possible (§6.6)
  client            Client?         @relation(fields: [clientId], references: [id])
  clientId          String?
  // Idempotence hors-ligne (§6.7) : UUID généré côté caisse, unique si renseigné.
  clientOperationId String?         @unique
  lignes            LigneVente[]
  retours           RetourVente[]
  paiements         PaiementVente[]
  devisOrigine      DevisClient?

  @@map("vente")
}

// Règlements d'une vente — un ticket, plusieurs modes (espèces + carte…).
// La clôture Z et le bordereau espèces s'appuient sur la part ESPECES, pas
// sur Vente.modePaiement (conservé comme mode principal pour l'historique).
model PaiementVente {
  id           String       @id @default(uuid())
  vente        Vente        @relation(fields: [venteId], references: [id], onDelete: Cascade)
  venteId      String
  modePaiement ModePaiement
  montant      Decimal      @db.Decimal(14, 2)

  @@unique([venteId, modePaiement])
  @@map("paiement_vente")
}

// Réservation de stock sur ticket en attente — n'écrit PAS MouvementStock.
// Disponible POS = StockQuant.quantite − somme(ReservationStock).
model ReservationStock {
  id              String        @id @default(uuid())
  sessionCaisse   SessionCaisse @relation(fields: [sessionCaisseId], references: [id], onDelete: Cascade)
  sessionCaisseId String
  holdId          String
  produit         Produit       @relation(fields: [produitId], references: [id])
  produitId       String
  entrepot        Entrepot      @relation(fields: [entrepotId], references: [id])
  entrepotId      String
  quantite        Int
  createdAt       DateTime      @default(now())

  @@unique([sessionCaisseId, holdId, produitId])
  @@index([entrepotId, produitId])
  @@map("reservation_stock")
}

// Ticket POS en attente (file de caisse) — snapshot pour reprise après
// refresh. Ce n'est PAS une Vente : aucun encaissement. Le stock est
// seulement réservé via ReservationStock.
model TicketAttente {
  id              String        @id
  sessionCaisse   SessionCaisse @relation(fields: [sessionCaisseId], references: [id], onDelete: Cascade)
  sessionCaisseId String
  numero          Int
  libelle         String
  motif           String
  clientId        String?
  remisePanier    String        @default("")
  panier          Json
  createdAt       DateTime      @default(now())

  @@index([sessionCaisseId])
  @@map("ticket_attente")
}

// Extension nécessaire au socle MCD pour un POS fonctionnel (détail des articles vendus)
model LigneVente {
  id           String        @id @default(uuid())
  vente        Vente         @relation(fields: [venteId], references: [id])
  venteId      String
  produit      Produit       @relation(fields: [produitId], references: [id])
  produitId    String
  quantite     Int
  prixUnitaire Decimal       @db.Decimal(14, 2)
  // Montant de remise sur cette ligne (jamais un pourcentage stocké — évite
  // toute ambiguïté d'arrondi). Plafonné à 20% de prixUnitaire×quantite,
  // contrôle serveur dans ventes.service.ts (extension au-delà du cahier
  // des charges, assumée — voir plan de la tâche).
  remise       Decimal       @default(0) @db.Decimal(14, 2)
  // Snapshot immuable du CMP (Produit.coutMoyenPondere) au moment de la
  // vente — sert de base à la rentabilité par boutique (reporting.service.ts).
  // Jamais recalculé rétroactivement, même si le CMP évolue ensuite (cohérence
  // grand livre). Nullable : les ventes antérieures à l'introduction de ce
  // suivi n'ont pas de coût connu — on ne fabrique pas de valeur a posteriori.
  coutUnitaire Decimal?      @db.Decimal(14, 2)
  retours      RetourVente[]

  @@map("ligne_vente")
}

// Retour/avoir : limité à une vente de la session de caisse en cours
// (contrôle applicatif dans ventes.service.ts) — évite de rouvrir une
// trésorerie déjà versée/validée. Extension au-delà du cahier des charges.
model RetourVente {
  id                String        @id @default(uuid())
  vente             Vente         @relation(fields: [venteId], references: [id])
  venteId           String
  ligneVente        LigneVente    @relation(fields: [ligneVenteId], references: [id])
  ligneVenteId      String
  quantite          Int
  montantRembourse  Decimal       @db.Decimal(14, 2)
  sessionCaisse     SessionCaisse @relation(fields: [sessionCaisseId], references: [id])
  sessionCaisseId   String
  utilisateur       Utilisateur   @relation(fields: [utilisateurId], references: [id])
  utilisateurId     String
  dateHeure         DateTime      @default(now())
  // Idempotence hors-ligne (§6.7) : UUID généré côté appareil, unique si renseigné.
  clientOperationId String?       @unique

  @@map("retour_vente")
}

// ---------------------------------------------------------------------------
// CRM (§6.6)
// ---------------------------------------------------------------------------

enum SegmentClient {
  NOUVEAU
  REGULIER
  VIP
}

// Personne physique (particulier) ou morale (entreprise / association) —
// une seule fiche réseau dans les deux cas (§6.6).
enum TypeClient {
  PHYSIQUE
  MORALE
}

model Client {
  id                    String        @id @default(uuid())
  typeClient            TypeClient    @default(PHYSIQUE)
  // PHYSIQUE : nom de famille ; MORALE : raison sociale.
  nom                   String
  // PHYSIQUE : prénom (obligatoire métier) ; MORALE : interlocuteur (optionnel).
  prenom                String?
  // contact / adresse / dateNaissance en clair au repos (décision produit
  // §6.7 : chiffrement = bcrypt des mots de passe ; pas de chiffrement
  // champ-à-champ des fiches client). Transport = TLS.
  contact               String?
  adresse               String?
  // Uniquement pertinente pour PHYSIQUE (ignorée / null pour MORALE).
  // Format ISO `YYYY-MM-DD`.
  dateNaissance         String?
  segment               SegmentClient @default(NOUVEAU)
  consentementMarketing Boolean       @default(false)
  // Magasin d’accueil (création) — pas une propriété exclusive : la fiche
  // reste unique réseau (§6.6). Sert à la liste d’exploitation magasin.
  boutiqueOrigine       Boutique?     @relation(fields: [boutiqueOrigineId], references: [id], onDelete: SetNull)
  boutiqueOrigineId     String?

  ventes       Vente[]
  fidelite     Fidelite?
  interactions InteractionCrm[]
  devis        DevisClient[]

  @@index([boutiqueOrigineId])
  @@map("client")
}

enum NiveauFidelite {
  BRONZE
  ARGENT
  OR
}

model Fidelite {
  id            String         @id @default(uuid())
  client        Client         @relation(fields: [clientId], references: [id])
  clientId      String         @unique
  pointsCumules Int            @default(0)
  niveau        NiveauFidelite @default(BRONZE)

  @@map("fidelite")
}

enum CanalInteraction {
  APPEL
  SMS
  WHATSAPP
  VISITE
  CAMPAGNE
  EMAIL
}

model InteractionCrm {
  id       String           @id @default(uuid())
  client   Client           @relation(fields: [clientId], references: [id])
  clientId String
  type     String
  date     DateTime         @default(now())
  canal    CanalInteraction
  contenu  String?

  @@map("interaction_crm")
}

// Campagnes ciblées (§6.6) : ciblage + CSV et/ou envoi SMTP/SMS (passerelle).
model CampagneCrm {
  id             String           @id @default(uuid())
  nom            String
  message        String
  segment        SegmentClient?
  niveauFidelite NiveauFidelite?
  canal          CanalInteraction
  dateCreation   DateTime         @default(now())
  dateEnvoi      DateTime?
  createdBy      Utilisateur      @relation(fields: [createdById], references: [id])
  createdById    String

  @@map("campagne_crm")
}

// ---------------------------------------------------------------------------
// Devis clients B2B — extension hors MCD §6.5.
// Règles figées (interprétation documentée, hors CDC) :
//   BROUILLON → ENVOYE → ACCEPTE | REFUSE
//   BROUILLON | ENVOYE → ANNULE
//   ACCEPTE → TRANSFORME (venteId optionnel, pas d’ouverture POS auto)
//   Montants hors TVA (pas de ligne TVA séparée).
//   Écriture : RESPONSABLE_CRM, RESPONSABLE_BOUTIQUE, DAF, DIRECTION_GENERALE.
// ---------------------------------------------------------------------------

enum StatutDevisClient {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  ANNULE
  TRANSFORME
}

model DevisClient {
  id           String             @id @default(uuid())
  numero       String             @unique
  statut       StatutDevisClient  @default(BROUILLON)
  client       Client             @relation(fields: [clientId], references: [id])
  clientId     String
  boutique     Boutique?          @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
  montantTotal Decimal            @db.Decimal(14, 2)
  notes        String?
  vente        Vente?             @relation(fields: [venteId], references: [id])
  venteId      String?            @unique
  createdBy    Utilisateur        @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lignes       LigneDevisClient[]

  @@index([clientId])
  @@index([statut])
  @@map("devis_client")
}

model LigneDevisClient {
  id           String      @id @default(uuid())
  devis        DevisClient @relation(fields: [devisId], references: [id], onDelete: Cascade)
  devisId      String
  produit      Produit?    @relation(fields: [produitId], references: [id])
  produitId    String?
  designation  String
  quantite     Int
  prixUnitaire Decimal     @db.Decimal(14, 2)
  remise       Decimal     @default(0) @db.Decimal(14, 2)

  @@map("ligne_devis_client")
}

// ---------------------------------------------------------------------------
// Traçabilité (§6.7) — journal d'audit horodaté et non modifiable.
// Aucun UPDATE/DELETE applicatif ne doit cibler cette table.
// ---------------------------------------------------------------------------

model JournalAudit {
  id            String      @id @default(uuid())
  dateHeure     DateTime    @default(now())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  action        String
  entite        String
  entiteId      String
  details       String?

  @@map("journal_audit")
}

// Trace append-only des notifications proactives déjà envoyées (§6.7
// « alertes automatiques ») — évite de renvoyer la même alerte (écart,
// retard, accès refusé) à chaque cycle du scheduler tant qu'elle n'a pas
// été régularisée. Jamais modifiée/supprimée, cohérent avec le journal
// d'audit.
model AlerteNotifiee {
  id        String   @id @default(uuid())
  type      String
  cleUnique String   @unique
  dateEnvoi DateTime @default(now())

  @@map("alerte_notifiee")
}
