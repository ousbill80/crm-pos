enum ModePaiement {
  ESPECES
  CARTE
  MOBILE_MONEY
}

// Session de caisse (§5.1) : comptage contradictoire à l'ouverture et à la
// fermeture. À la clôture sans écart : TRANSFERT_INTERNE tiroir→magasin
// (espèces comptées) puis SORTIE_FONDS magasin→centrale du point du jour
// (fond compté − fond initial), circuit §6.4 Initiée → transit →
// réception DAF / Caissier central → validation.
enum StatutSessionCaisse {
  OUVERTE
  FERMEE
}

model SessionCaisse {
  id                     String              @id @default(uuid())
  caisse                 Caisse              @relation(fields: [caisseId], references: [id])
  caisseId               String
  statut                 StatutSessionCaisse @default(OUVERTE)
  ouvertureDateHeure     DateTime            @default(now())
  fondInitial            Decimal             @db.Decimal(14, 2)
  ouvertureUtilisateur   Utilisateur         @relation("OuvertureSession", fields: [ouvertureUtilisateurId], references: [id])
  ouvertureUtilisateurId String
  // Comptage contradictoire (§5.1) : le témoin EST ré-authentifié par mot de
  // passe côté serveur (resoudreTemoin, bcrypt.compare réel) — pas une simplification.
  ouvertureTemoin        Utilisateur         @relation("OuvertureTemoin", fields: [ouvertureTemoinId], references: [id])
  ouvertureTemoinId      String
  clotureDateHeure       DateTime?
  fondCompteCloture      Decimal?            @db.Decimal(14, 2)
  clotureUtilisateur     Utilisateur?        @relation("ClotureSession", fields: [clotureUtilisateurId], references: [id])
  clotureUtilisateurId   String?
  clotureTemoin          Utilisateur?        @relation("ClotureTemoin", fields: [clotureTemoinId], references: [id])
  clotureTemoinId        String?
  transactionVersement   TransactionCaisse?  @relation("SessionRemiseMagasin", fields: [transactionVersementId], references: [id])
  transactionVersementId String?             @unique
  // Bordereau magasin → centrale du point du jour (§6.4), créé à la clôture
  // sans écart. Réception / validation : Caissier Central ou DAF.
  transactionSortieCentrale   TransactionCaisse?  @relation("SessionSortieCentrale", fields: [transactionSortieCentraleId], references: [id])
  transactionSortieCentraleId String?             @unique
  // Idempotence hors-ligne (§6.7) : UUID généré côté appareil, unique si renseigné.
  clientOperationId      String?             @unique
  ventes                 Vente[]
  retours                RetourVente[]
  reservations           ReservationStock[]
  ticketsAttente         TicketAttente[]

  @@map("session_caisse")
}

model Vente {
  id                 String                   @id @default(uuid())
  dateVente          DateTime                 @default(now())
  montantTotal       Decimal                  @db.Decimal(14, 2)
  // Avantage fidélité (§6.6) appliqué à l'encaissement, tracé séparément du
  // montant total (montantTotal est déjà net de cette remise).
  remiseFidelite     Decimal                  @default(0) @db.Decimal(14, 2)
  modePaiement       ModePaiement
  caisse             Caisse                   @relation(fields: [caisseId], references: [id])
  caisseId           String
  sessionCaisse      SessionCaisse            @relation(fields: [sessionCaisseId], references: [id])
  sessionCaisseId    String
  // Rattachement client optionnel — la vente anonyme doit rester possible (§6.6)
  client             Client?                  @relation(fields: [clientId], references: [id])
  clientId           String?
  // Idempotence hors-ligne (§6.7) : UUID généré côté caisse, unique si renseigné.
  clientOperationId  String?                  @unique
  lignes             LigneVente[]
  retours            RetourVente[]
  paiements          PaiementVente[]
  devisOrigine       DevisClient?
  conversionCommande ConversionCommandeVente?

  @@map("vente")
}

// Règlements d'une vente — un ticket, plusieurs modes (espèces + carte…).
// La clôture Z et le bordereau espèces s'appuient sur la part ESPECES, pas
// sur Vente.modePaiement (conservé comme mode principal pour l'historique).
model PaiementVente {
  id           String       @id @default(uuid())
  vente        Vente        @relation(fields: [venteId], references: [id], onDelete: Cascade)
  venteId      String
  modePaiement ModePaiement
  montant      Decimal      @db.Decimal(14, 2)

  @@unique([venteId, modePaiement])
  @@map("paiement_vente")
}

// Réservation de stock sur ticket en attente — n'écrit PAS MouvementStock.
// Disponible POS = StockQuant.quantite − somme(ReservationStock).
model ReservationStock {
  id              String        @id @default(uuid())
  sessionCaisse   SessionCaisse @relation(fields: [sessionCaisseId], references: [id], onDelete: Cascade)
  sessionCaisseId String
  holdId          String
  produit         Produit       @relation(fields: [produitId], references: [id])
  produitId       String
  entrepot        Entrepot      @relation(fields: [entrepotId], references: [id])
  entrepotId      String
  quantite        Int
  createdAt       DateTime      @default(now())

  @@unique([sessionCaisseId, holdId, produitId])
  @@index([entrepotId, produitId])
  @@map("reservation_stock")
}

// Ticket POS en attente (file de caisse) — snapshot pour reprise après
// refresh. Ce n'est PAS une Vente : aucun encaissement. Le stock est
// seulement réservé via ReservationStock.
model TicketAttente {
  id              String        @id
  sessionCaisse   SessionCaisse @relation(fields: [sessionCaisseId], references: [id], onDelete: Cascade)
  sessionCaisseId String
  numero          Int
  libelle         String
  motif           String
  clientId        String?
  remisePanier    String        @default("")
  panier          Json
  createdAt       DateTime      @default(now())

  @@index([sessionCaisseId])
  @@map("ticket_attente")
}

// Extension nécessaire au socle MCD pour un POS fonctionnel (détail des articles vendus)
model LigneVente {
  id           String        @id @default(uuid())
  vente        Vente         @relation(fields: [venteId], references: [id])
  venteId      String
  produit      Produit       @relation(fields: [produitId], references: [id])
  produitId    String
  quantite     Int
  prixUnitaire Decimal       @db.Decimal(14, 2)
  // Montant de remise sur cette ligne (jamais un pourcentage stocké — évite
  // toute ambiguïté d'arrondi). Plafonné à 20% de prixUnitaire×quantite,
  // contrôle serveur dans ventes.service.ts (extension au-delà du cahier
  // des charges, assumée — voir plan de la tâche).
  remise       Decimal       @default(0) @db.Decimal(14, 2)
  // Snapshot immuable du CMP (Produit.coutMoyenPondere) au moment de la
  // vente — sert de base à la rentabilité par boutique (reporting.service.ts).
  // Jamais recalculé rétroactivement, même si le CMP évolue ensuite (cohérence
  // grand livre). Nullable : les ventes antérieures à l'introduction de ce
  // suivi n'ont pas de coût connu — on ne fabrique pas de valeur a posteriori.
  coutUnitaire Decimal?      @db.Decimal(14, 2)
  retours      RetourVente[]

  @@map("ligne_vente")
}

// Retour/avoir : limité à une vente de la session de caisse en cours
// (contrôle applicatif dans ventes.service.ts) — évite de rouvrir une
// trésorerie déjà versée/validée. Extension au-delà du cahier des charges.
model RetourVente {
  id                String        @id @default(uuid())
  vente             Vente         @relation(fields: [venteId], references: [id])
  venteId           String
  ligneVente        LigneVente    @relation(fields: [ligneVenteId], references: [id])
  ligneVenteId      String
  quantite          Int
  montantRembourse  Decimal       @db.Decimal(14, 2)
  sessionCaisse     SessionCaisse @relation(fields: [sessionCaisseId], references: [id])
  sessionCaisseId   String
  utilisateur       Utilisateur   @relation(fields: [utilisateurId], references: [id])
  utilisateurId     String
  dateHeure         DateTime      @default(now())
  // Idempotence hors-ligne (§6.7) : UUID généré côté appareil, unique si renseigné.
  clientOperationId String?       @unique

  @@map("retour_vente")
}

// ---------------------------------------------------------------------------
// CRM (§6.6)
// ---------------------------------------------------------------------------

enum SegmentClient {
  NOUVEAU
  REGULIER
  VIP
}

// Personne physique (particulier) ou morale (entreprise / association) —
// une seule fiche réseau dans les deux cas (§6.6).
enum TypeClient {
  PHYSIQUE
  MORALE
}

model Client {
  id                    String        @id @default(uuid())
  typeClient            TypeClient    @default(PHYSIQUE)
  // PHYSIQUE : nom de famille ; MORALE : raison sociale.
  nom                   String
  // PHYSIQUE : prénom (obligatoire métier) ; MORALE : interlocuteur (optionnel).
  prenom                String?
  // contact / adresse / dateNaissance en clair au repos (décision produit
  // §6.7 : chiffrement = bcrypt des mots de passe ; pas de chiffrement
  // champ-à-champ des fiches client). Transport = TLS.
  contact               String?
  adresse               String?
  // Uniquement pertinente pour PHYSIQUE (ignorée / null pour MORALE).
  // Format ISO `YYYY-MM-DD`.
  dateNaissance         String?
  segment               SegmentClient @default(NOUVEAU)
  consentementMarketing Boolean       @default(false)
  // Magasin d’accueil (création) — pas une propriété exclusive : la fiche
  // reste unique réseau (§6.6). Sert à la liste d’exploitation magasin.
  boutiqueOrigine       Boutique?     @relation(fields: [boutiqueOrigineId], references: [id], onDelete: SetNull)
  boutiqueOrigineId     String?

  ventes       Vente[]
  fidelite     Fidelite?
  interactions InteractionCrm[]
  devis        DevisClient[]
  factures     FactureClient[]
  compteClient CompteClient?
  adresses     AdresseClient[]
  commandesWeb CommandeWeb[]
  lignesEcriture LigneEcritureComptable[]

  @@index([boutiqueOrigineId])
  @@map("client")
}

enum NiveauFidelite {
  BRONZE
  ARGENT
  OR
}

model Fidelite {
  id            String         @id @default(uuid())
  client        Client         @relation(fields: [clientId], references: [id])
  clientId      String         @unique
  pointsCumules Int            @default(0)
  niveau        NiveauFidelite @default(BRONZE)

  @@map("fidelite")
}

enum CanalInteraction {
  APPEL
  SMS
  WHATSAPP
  VISITE
  CAMPAGNE
  EMAIL
}

model InteractionCrm {
  id       String           @id @default(uuid())
  client   Client           @relation(fields: [clientId], references: [id])
  clientId String
  type     String
  date     DateTime         @default(now())
  canal    CanalInteraction
  contenu  String?

  @@map("interaction_crm")
}

// Campagnes ciblées (§6.6) : ciblage + CSV et/ou envoi SMTP/SMS (passerelle).
model CampagneCrm {
  id             String           @id @default(uuid())
  nom            String
  message        String
  segment        SegmentClient?
  niveauFidelite NiveauFidelite?
  canal          CanalInteraction
  dateCreation   DateTime         @default(now())
  dateEnvoi      DateTime?
  createdBy      Utilisateur      @relation(fields: [createdById], references: [id])
  createdById    String

  @@map("campagne_crm")
}

// ---------------------------------------------------------------------------
// Devis clients B2B — extension hors MCD §6.5.
// Règles figées (interprétation documentée, hors CDC) :
//   BROUILLON → ENVOYE → ACCEPTE | REFUSE
//   BROUILLON | ENVOYE → ANNULE
//   ACCEPTE → TRANSFORME (venteId optionnel, pas d’ouverture POS auto)
//   Montants hors TVA (pas de ligne TVA séparée).
//   Écriture : RESPONSABLE_CRM, RESPONSABLE_BOUTIQUE, DAF, DIRECTION_GENERALE.
// ---------------------------------------------------------------------------

enum StatutDevisClient {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  ANNULE
  TRANSFORME
}

model DevisClient {
  id           String             @id @default(uuid())
  numero       String             @unique
  statut       StatutDevisClient  @default(BROUILLON)
  client       Client             @relation(fields: [clientId], references: [id])
  clientId     String
  boutique     Boutique?          @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
  montantTotal Decimal            @db.Decimal(14, 2)
  notes        String?
  vente          Vente?             @relation(fields: [venteId], references: [id])
  venteId        String?            @unique
  factureClient  FactureClient?
  createdBy      Utilisateur        @relation(fields: [createdById], references: [id])
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lignes         LigneDevisClient[]

  @@index([clientId])
  @@index([statut])
  @@map("devis_client")
}

model LigneDevisClient {
  id           String      @id @default(uuid())
  devis        DevisClient @relation(fields: [devisId], references: [id], onDelete: Cascade)
  devisId      String
  produit      Produit?    @relation(fields: [produitId], references: [id])
  produitId    String?
  designation  String
  quantite     Int
  prixUnitaire Decimal     @db.Decimal(14, 2)
  remise       Decimal     @default(0) @db.Decimal(14, 2)

  @@map("ligne_devis_client")
}

// ---------------------------------------------------------------------------
// Facture client B2B (hors CDC — pièce distincte du ticket POS / commande web)
// Prix HT comme le devis ; TVA au taux produit sinon taux shop. GL FACTURE_CLIENT.
// ---------------------------------------------------------------------------

enum StatutFactureClient {
  BROUILLON
  EMISE
  ANNULEE
}

enum ModeEncaissementFactureClient {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  CARTE
}

model FactureClient {
  id           String                 @id @default(uuid())
  numero       String                 @unique
  statut       StatutFactureClient    @default(BROUILLON)
  client       Client                 @relation(fields: [clientId], references: [id])
  clientId     String
  boutique     Boutique?              @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
  devis        DevisClient?           @relation(fields: [devisId], references: [id])
  devisId      String?                @unique
  dateFacture  DateTime               @default(now())
  dateEcheance DateTime?
  montantHt    Decimal                @db.Decimal(14, 2)
  montantTva   Decimal                @db.Decimal(14, 2)
  montantTtc   Decimal                @db.Decimal(14, 2)
  notes        String?
  createdBy    Utilisateur            @relation("FactureClientCreateur", fields: [createdById], references: [id])
  createdById  String
  emisePar     Utilisateur?           @relation("FactureClientEmission", fields: [emiseParId], references: [id])
  emiseParId   String?
  emiseAt      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  lignes       LigneFactureClient[]
  paiements    PaiementFactureClient[]

  @@index([clientId])
  @@index([statut])
  @@map("facture_client")
}

model LigneFactureClient {
  id           String        @id @default(uuid())
  facture      FactureClient @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId    String
  produit      Produit?      @relation(fields: [produitId], references: [id])
  produitId    String?
  designation  String
  quantite     Int
  prixUnitaire Decimal       @db.Decimal(14, 2)
  remise       Decimal       @default(0) @db.Decimal(14, 2)
  tauxTva      Decimal       @db.Decimal(5, 2)
  montantHt    Decimal       @db.Decimal(14, 2)
  montantTva   Decimal       @db.Decimal(14, 2)
  montantTtc   Decimal       @db.Decimal(14, 2)
  coutUnitaire Decimal?      @db.Decimal(14, 2)

  @@map("ligne_facture_client")
}

model PaiementFactureClient {
  id           String                       @id @default(uuid())
  facture      FactureClient                @relation(fields: [factureId], references: [id])
  factureId    String
  montant      Decimal                      @db.Decimal(14, 2)
  mode         ModeEncaissementFactureClient
  datePaiement DateTime                     @default(now())
  reference    String?
  createdBy    Utilisateur                  @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime                     @default(now())

  @@index([factureId])
  @@map("paiement_facture_client")
}

// ---------------------------------------------------------------------------
// E-commerce B2C (PLAN-E-COMMERCE — extension hors MCD §6.5, §6.6 checkout invité)
// ---------------------------------------------------------------------------

enum ModeAffichagePrixShop {
  HT
  TTC
}

enum ModeReglementCommandeWeb {
  PREPAYE_PSP
  PAIEMENT_RETRAIT
  PAIEMENT_LIVRAISON
}

enum ProviderPspShop {
  PAYSTACK
  ORANGE_MONEY
  WAVE
}

enum ModeFulfillmentCommandeWeb {
  RETRAIT_BOUTIQUE
  LIVRAISON
}

enum StatutCommandeWeb {
  PANIER
  EN_ATTENTE_PAIEMENT
  PAYEE
  PREPARATION
  PRETE
  EXPEDIEE
  LIVREE
  REMISE
  ANNULEE
  REMBOURSEE
  LITIGE
}

enum ShopFunnelEtape {
  ACQUISITION
  ACTIVATION
  REVENUE
  RETENTION
  REFERRAL
}

enum TypePaiementCommandeWeb {
  INITIE
  CAPTURE
  REMBOURSEMENT
  ECHEC
}

enum StatutPaiementCommandeWeb {
  EN_COURS
  REUSSI
  ECHEC
  REMBOURSE
}

model ParametreShop {
  id                        String                @id @default(uuid())
  societe                   Societe               @relation(fields: [societeId], references: [id])
  societeId                 String                @unique
  shopActif                 Boolean               @default(false)
  entrepotWebDefaut         Entrepot?             @relation("ParametreShopEntrepotDefaut", fields: [entrepotWebDefautId], references: [id], onDelete: SetNull)
  entrepotWebDefautId       String?
  dureeReservationPanierMin Int                   @default(15)
  retraitActif              Boolean               @default(true)
  livraisonActive           Boolean               @default(true)
  deviseAffichage           String                @default("XOF")
  modeAffichagePrix         ModeAffichagePrixShop @default(HT)
  tauxTvaDefaut             Decimal               @default(18) @db.Decimal(5, 2)
  afficherDetailTvaPanier   Boolean               @default(true)
  fallbackPrixMagasin       Boolean               @default(true)
  paiementRetraitActif      Boolean               @default(true)
  paiementLivraisonActif    Boolean               @default(true)
  modesPaiementRetrait      ModePaiement[]        @default([ESPECES])
  modesPaiementLivraison    ModePaiement[]        @default([ESPECES])
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@map("parametre_shop")
}

model CompteClient {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  client           Client          @relation(fields: [clientId], references: [id])
  clientId         String          @unique
  emailVerifie     Boolean         @default(false)
  actif            Boolean         @default(true)
  refreshTokenHash String?
  codeParrainage   String          @unique
  parrain          CompteClient?   @relation("ParrainageShop", fields: [parrainId], references: [id], onDelete: SetNull)
  parrainId        String?
  filleuls         CompteClient[]  @relation("ParrainageShop")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  adresses         AdresseClient[]
  commandesWeb     CommandeWeb[]
  funnelEvents     ShopFunnelEvent[]

  @@index([parrainId])
  @@map("compte_client")
}

model ShopFunnelEvent {
  id             String          @id @default(uuid())
  etape          ShopFunnelEtape
  action         String
  sessionId      String
  compteClient   CompteClient?   @relation(fields: [compteClientId], references: [id], onDelete: SetNull)
  compteClientId String?
  produit        Produit?        @relation(fields: [produitId], references: [id], onDelete: SetNull)
  produitId      String?
  commandeWeb    CommandeWeb?    @relation(fields: [commandeWebId], references: [id], onDelete: SetNull)
  commandeWebId  String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  codeParrain    String?
  requete        String?
  createdAt      DateTime        @default(now())

  @@index([sessionId, createdAt])
  @@index([etape, createdAt])
  @@index([action, createdAt])
  @@index([compteClientId, createdAt])
  @@index([produitId])
  @@map("shop_funnel_event")
}

model AdresseClient {
  id             String        @id @default(uuid())
  compteClient   CompteClient? @relation(fields: [compteClientId], references: [id], onDelete: Cascade)
  compteClientId String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId       String?
  libelle        String
  ligne1         String
  ligne2         String?
  ville          String
  region         String?
  codePostal     String?
  pays           String        @default("SN")
  telephone      String?
  lat            Decimal?      @db.Decimal(10, 7)
  lng            Decimal?      @db.Decimal(10, 7)
  createdAt      DateTime      @default(now())

  @@map("adresse_client")
}

model ZoneLivraison {
  id               String        @id @default(uuid())
  libelle          String
  actif            Boolean       @default(true)
  tarifForfait     Decimal       @db.Decimal(14, 2)
  delaiJoursMin    Int           @default(1)
  delaiJoursMax    Int           @default(3)
  villesJson       Json?
  codesPostauxJson Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  commandesWeb     CommandeWeb[]

  @@map("zone_livraison")
}

model CommandeWeb {
  id                   String                     @id @default(uuid())
  clientOperationId    String                     @unique
  statut               StatutCommandeWeb          @default(PANIER)
  modeFulfillment      ModeFulfillmentCommandeWeb
  modeReglement        ModeReglementCommandeWeb
  providerPsp          ProviderPspShop?
  canal                String                     @default("WEB")
  client               Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId             String?
  compteClient         CompteClient?              @relation(fields: [compteClientId], references: [id], onDelete: SetNull)
  compteClientId       String?
  emailInvite          String?
  telephoneInvite      String?
  boutiqueRetrait      Boutique?                  @relation("CommandeRetraitBoutique", fields: [boutiqueRetraitId], references: [id], onDelete: SetNull)
  boutiqueRetraitId    String?
  entrepot             Entrepot                   @relation(fields: [entrepotId], references: [id])
  entrepotId           String
  zoneLivraison        ZoneLivraison?             @relation(fields: [zoneLivraisonId], references: [id], onDelete: SetNull)
  zoneLivraisonId      String?
  adresseLivraisonJson Json?
  montantArticlesHt    Decimal                    @default(0) @db.Decimal(14, 2)
  montantTva           Decimal                    @default(0) @db.Decimal(14, 2)
  montantArticlesTtc   Decimal                    @default(0) @db.Decimal(14, 2)
  remiseFidelite       Decimal                    @default(0) @db.Decimal(14, 2)
  fraisLivraison       Decimal                    @default(0) @db.Decimal(14, 2)
  montantTotal         Decimal                    @default(0) @db.Decimal(14, 2)
  numeroSuivi          String?
  noteClient           String?
  suiviToken           String?                    @unique
  payeeAt              DateTime?
  expireAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  lignes               LigneCommandeWeb[]
  reservations         ReservationWeb[]
  paiements            PaiementCommandeWeb[]
  conversionVente      ConversionCommandeVente?
  avis                 AvisCommandeWeb?
  funnelEvents         ShopFunnelEvent[]

  @@index([statut])
  @@index([compteClientId])
  @@index([clientId])
  @@map("commande_web")
}

model LigneCommandeWeb {
  id                  String      @id @default(uuid())
  commande            CommandeWeb @relation(fields: [commandeWebId], references: [id], onDelete: Cascade)
  commandeWebId       String
  produit             Produit     @relation(fields: [produitId], references: [id])
  produitId           String
  quantite            Int
  prixUnitaireHt      Decimal     @db.Decimal(14, 2)
  tauxTva             Decimal     @db.Decimal(5, 2)
  montantTvaLigne     Decimal     @db.Decimal(14, 2)
  prixUnitaireTtc     Decimal     @db.Decimal(14, 2)
  designationSnapshot String
  referenceSnapshot   String?

  @@map("ligne_commande_web")
}

model ReservationWeb {
  id            String      @id @default(uuid())
  holdId        String      @unique
  commande      CommandeWeb @relation(fields: [commandeWebId], references: [id], onDelete: Cascade)
  commandeWebId String
  produit       Produit     @relation(fields: [produitId], references: [id])
  produitId     String
  entrepot      Entrepot    @relation(fields: [entrepotId], references: [id])
  entrepotId    String
  quantite      Int
  expireAt      DateTime
  createdAt     DateTime    @default(now())

  @@index([produitId, entrepotId])
  @@index([expireAt])
  @@map("reservation_web")
}

model PaiementCommandeWeb {
  id                 String                    @id @default(uuid())
  commande           CommandeWeb               @relation(fields: [commandeWebId], references: [id])
  commandeWebId      String
  provider           ProviderPspShop
  type               TypePaiementCommandeWeb
  referenceExterne   String?
  referenceProvider  String?
  montant            Decimal                   @db.Decimal(14, 2)
  devise             String                    @default("XOF")
  statut             StatutPaiementCommandeWeb
  payloadWebhookJson Json?
  webhookEventId     String?
  createdAt          DateTime                  @default(now())

  @@unique([provider, webhookEventId])
  @@index([commandeWebId])
  @@map("paiement_commande_web")
}

model ConversionCommandeVente {
  id            String      @id @default(uuid())
  commande      CommandeWeb @relation(fields: [commandeWebId], references: [id])
  commandeWebId String      @unique
  vente         Vente       @relation(fields: [venteId], references: [id])
  venteId       String      @unique
  createdAt     DateTime    @default(now())

  @@map("conversion_commande_vente")
}

/** Avis service post-livraison / post-retrait (token public). */
model AvisCommandeWeb {
  id            String      @id @default(uuid())
  commande      CommandeWeb @relation(fields: [commandeWebId], references: [id], onDelete: Cascade)
  commandeWebId String      @unique
  token         String      @unique
  note          Int?
  commentaire   String?
  soumisAt      DateTime?
  createdAt     DateTime    @default(now())

  @@map("avis_commande_web")
}

model WebhookJournal {
  id        String   @id @default(uuid())
  provider  String
  eventType String
  eventId   String
  payload   Json
  traite    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("webhook_journal")
}

// ---------------------------------------------------------------------------
// Traçabilité (§6.7) — journal d'audit horodaté et non modifiable.
// Aucun UPDATE/DELETE applicatif ne doit cibler cette table.
// ---------------------------------------------------------------------------

model JournalAudit {
  id            String      @id @default(uuid())
  dateHeure     DateTime    @default(now())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  action        String
  entite        String
  entiteId      String
  details       String?

  @@index([utilisateurId, action, dateHeure])
  @@map("journal_audit")
}

// ---------------------------------------------------------------------------
// Accounting intelligence — advisory layer only. Deterministic controls and
// the existing append-only ledger remain authoritative.
// ---------------------------------------------------------------------------

enum AccountingAiSourceType {
  SUPPLIER_INVOICE
  SUPPLIER_CREDIT
  SUPPLIER_PAYMENT
  CUSTOMER_INVOICE
  POS_SALE
  POS_RETURN
  POS_DISCOUNT
  CASH_REMITTANCE
  BANK_MOVEMENT
  STOCK_MOVEMENT
  LANDED_COST
  CUSTOMS
  TAX
}

enum AccountingAiWorkStatus {
  QUEUED
  ANALYZED
  RAF_REVIEW
  AUTO_POST_ELIGIBLE
  DECIDED
}

enum AccountingAiSuggestionKind {
  DOCUMENT_CLASSIFICATION
  JOURNAL_CODING
  ACCOUNT_CODING
  TAX_CODING
  ANALYTIC_CODING
  MATCHING
  ANOMALY
}

enum AccountingAiDecision {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_APPROVED
}

enum AccountingAiRisk {
  LOW
  MEDIUM
  HIGH
}

enum AccountingAuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AccountingAuditFindingStatus {
  OPEN
  ASSIGNED
  RESOLVED
  STORNO_REQUIRED
}

model AccountingAiWorkItem {
  id                    String                 @id @default(uuid())
  societeId             String
  sourceType            AccountingAiSourceType
  sourceId              String
  sourceSnapshot        Json
  sourceHash            String
  status                AccountingAiWorkStatus @default(QUEUED)
  deterministicChecks   Json
  deterministicBlockers Json
  providerMode          String
  providerErrorCode     String?
  createdById           String
  createdAt             DateTime               @default(now())
  suggestions           AccountingAiSuggestion[]
  findings              AccountingAuditFinding[]
  evidence              AccountingAiEvidence[]

  @@unique([societeId, sourceType, sourceId])
  @@index([societeId, status, createdAt])
  @@map("accounting_ai_work_item")
}

model AccountingAiSuggestion {
  id             String                       @id @default(uuid())
  workItem       AccountingAiWorkItem         @relation(fields: [workItemId], references: [id])
  workItemId     String
  kind           AccountingAiSuggestionKind
  value          Json
  confidence     Decimal                      @db.Decimal(5, 4)
  evidence       Json
  ruleCitations  Json
  risk           AccountingAiRisk
  modelVersion   String
  modelHash      String
  promptHash     String
  createdAt      DateTime                     @default(now())
  decisions      AccountingAiDecisionEvent[]

  @@index([workItemId, kind])
  @@map("accounting_ai_suggestion")
}

model AccountingAiDecisionEvent {
  id           String                   @id @default(uuid())
  suggestion   AccountingAiSuggestion   @relation(fields: [suggestionId], references: [id])
  suggestionId String
  decision     AccountingAiDecision
  actorId      String
  reason       String?
  evidenceHash String
  createdAt    DateTime                 @default(now())

  @@index([suggestionId, createdAt])
  @@map("accounting_ai_decision_event")
}

model AccountingAiPolicy {
  id                  String                 @id @default(uuid())
  societeId           String
  sourceType          AccountingAiSourceType
  suggestionKind      AccountingAiSuggestionKind
  minimumConfidence   Decimal                @db.Decimal(5, 4)
  maximumRisk         AccountingAiRisk       @default(LOW)
  active              Boolean                @default(false)
  approvedByDafId     String?
  approvedAt          DateTime?
  version             Int
  createdById         String
  createdAt           DateTime               @default(now())

  @@unique([societeId, sourceType, suggestionKind, version])
  @@index([societeId, active])
  @@map("accounting_ai_policy")
}

model AccountingAuditFinding {
  id                String                        @id @default(uuid())
  workItem          AccountingAiWorkItem          @relation(fields: [workItemId], references: [id])
  workItemId        String
  severity          AccountingAuditSeverity
  ruleCode          String
  title             String
  details           Json
  status            AccountingAuditFindingStatus  @default(OPEN)
  assignedToId      String?
  resolution        String?
  stornoEntryId     String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime                      @default(now())

  @@index([status, severity, assignedToId])
  @@map("accounting_audit_finding")
}

model AccountingAiEvidence {
  id          String               @id @default(uuid())
  workItem    AccountingAiWorkItem @relation(fields: [workItemId], references: [id])
  workItemId  String
  eventType   String
  actorId     String?
  evidence    Json
  evidenceHash String
  createdAt   DateTime             @default(now())

  @@index([workItemId, createdAt])
  @@map("accounting_ai_evidence")
}

// Trace append-only des notifications proactives déjà envoyées (§6.7
// « alertes automatiques ») — évite de renvoyer la même alerte (écart,
// retard, accès refusé) à chaque cycle du scheduler tant qu'elle n'a pas
// été régularisée. Jamais modifiée/supprimée, cohérent avec le journal
// d'audit.
model AlerteNotifiee {
  id        String   @id @default(uuid())
  type      String
  cleUnique String   @unique
  dateEnvoi DateTime @default(now())

  @@map("alerte_notifiee")
}

model StaffBriefingEnvoi {
  id               String   @id @default(uuid())
  type             String
  cleUnique        String   @unique
  utilisateurId    String?
  destinataireHash String
  resendId         String?
  createdAt        DateTime @default(now())

  @@index([type, createdAt])
  @@map("staff_briefing_envoi")
}
