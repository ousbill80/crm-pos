// Schéma Prisma — Progiciel Caisses & CRM
// Référence : Cahier_des_charges_Caisses_CRM.docx §6.5 (Modèle Conceptuel de Données)
// Toute modification de ce fichier doit rester traçable à une section du cahier des charges.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organisation (§3, §4)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Entreprise — fiche société mono-tenant (paramètres légaux / devise).
// ---------------------------------------------------------------------------

model Societe {
  id                              String                           @id @default(uuid())
  raisonSociale                   String
  adresse                         String
  telephone                       String?
  email                           String?
  devise                          String                           @default("XOF")
  logoUrl                         String?
  // Montant (FCFA) au-delà duquel seul la Direction Générale peut valider
  // un rapprochement sans écart (§4 « validation seuils exceptionnels »).
  seuilValidationDg               Decimal                          @default(5000000) @db.Decimal(14, 2)
  // Délai (heures) au-delà duquel un versement non transmis déclenche une
  // alerte et est compté en retard dans le reporting DAF (§6.3.5 « gestion
  // des seuils : montants de versement, délais »).
  delaiVersementHeures            Int                              @default(24)
  // Seuils CRM paramétrables (§6.6) — défauts = première itération documentée.
  seuilFideliteArgent             Int                              @default(500)
  seuilFideliteOr                 Int                              @default(2000)
  seuilSegmentRegulier            Int                              @default(5)
  seuilSegmentVip                 Int                              @default(15)
  // Avantages fidélité (§6.6 « avantages associés ») : remise % appliquée
  // automatiquement à l'encaissement pour un client aux paliers Argent/Or.
  // Défaut 0 = désactivé — le cahier ne chiffre pas ces avantages, c'est à
  // l'admin de les activer et de les chiffrer (comme les autres seuils).
  avantageFideliteArgentPct       Int                              @default(0)
  avantageFideliteOrPct           Int                              @default(0)
  // Seuil de caisse (§5.1 « par exemple 500 000 FCFA ») au-delà duquel une
  // alerte de versement anticipé est déclenchée en cours de journée. Null =
  // désactivé (le cahier ne donne qu'un exemple, pas une valeur imposée).
  seuilVersementAnticipe          Decimal?                         @db.Decimal(14, 2)
  // Délai (heures) de régularisation d'un litige avant alerte de retard
  // (§5.1 « sous 24 à 48 heures » — 48h = borne haute retenue par défaut).
  delaiRegularisationLitigeHeures Int                              @default(48)
  centresCout                     CentreCout[]
  reglesApprobationAchat          RegleApprobationAchat[]
  referentielsFiscaux             ReferentielFiscal[]
  exercicesComptables             ExerciceComptable[]
  comptesComptables               CompteComptable[]
  journauxComptables              JournalComptable[]
  periodesComptables              PeriodeComptable[]
  modelesComptables               ModeleComptabilisation[]
  ecrituresComptables             EcritureComptable[]
  comptesTresorerie               CompteTresorerie[]
  propositionsPaiement            PropositionPaiementFournisseur[]
  importsReleveBancaire           ImportReleveBancaire[]
  commandesAchat                  CommandeAchat[]
  sequencesDocumentsAchat         SequenceDocumentAchat[]
  evidencesP2p                    EvidenceP2p[]
  parametreShop                   ParametreShop?
  naturesDepense                  NatureDepense[]
  filesEcritureComptable          FileEcritureComptable[]
  facturesFournisseur             FactureFournisseur[]
  immobilisations                 Immobilisation[]

  @@map("societe")
}

model Zone {
  id        String     @id @default(uuid())
  nomZone   String
  boutiques Boutique[]

  @@map("zone")
}

model Boutique {
  id                  String          @id @default(uuid())
  nom                 String
  adresse             String
  code                String?
  actif               Boolean         @default(true)
  zone                Zone            @relation(fields: [zoneId], references: [id])
  zoneId              String
  caisses             Caisse[]
  utilisateurs        Utilisateur[]
  entrepots           Entrepot[]
  commandesAchat      CommandeAchat[]
  demandesAchat       DemandeAchat[]
  centresCout         CentreCout[]
  evidencesP2p        EvidenceP2p[]
  clientsOrigine      Client[]
  devisClients        DevisClient[]
  facturesClient      FactureClient[]
  // E-commerce — click & collect (PLAN-E-COMMERCE §3)
  retraitWebActif     Boolean         @default(false)
  entrepotWeb         Entrepot?       @relation("BoutiqueEntrepotWeb", fields: [entrepotWebId], references: [id], onDelete: SetNull)
  entrepotWebId       String?
  delaiRetraitHeures  Int?
  commandesWebRetrait CommandeWeb[]   @relation("CommandeRetraitBoutique")

  @@map("boutique")
}

enum TypeEntrepot {
  PRINCIPAL
  SECONDAIRE
}

enum UsageEmplacement {
  STOCK
  ENTREE
  QUARANTAINE
  SORTIE
  PERTE
  FOURNISSEUR
  CLIENT
}

// Emplacement de stock rattaché à une boutique. Chaque boutique a au moins
// un entrepôt PRINCIPAL (consommé par le POS de la boutique).
model Entrepot {
  id                      String                   @id @default(uuid())
  nom                     String
  code                    String
  type                    TypeEntrepot             @default(PRINCIPAL)
  usage                   UsageEmplacement         @default(STOCK)
  reseau                  Boolean                  @default(false)
  virtuel                 Boolean                  @default(false)
  actif                   Boolean                  @default(true)
  boutique                Boutique                 @relation(fields: [boutiqueId], references: [id])
  boutiqueId              String
  quants                  StockQuant[]
  mouvements              MouvementStock[]
  sessionsInventaire      SessionInventaire[]
  receptions              ReceptionStock[]
  reservations            ReservationStock[]
  reservationsWeb         ReservationWeb[]
  boutiquesWeb            Boutique[]               @relation("BoutiqueEntrepotWeb")
  parametresShopDefaut    ParametreShop[]          @relation("ParametreShopEntrepotDefaut")
  commandesWeb            CommandeWeb[]
  stockLots               StockLot[]
  bonsSource              BonStock[]               @relation("BonStockSource")
  bonsDest                BonStock[]               @relation("BonStockDest")
  reglesReappro           RegleReappro[]
  receptionsQuarantaine   ReceptionAchat[]         @relation("ReceptionQuarantaine")
  lignesMiseEnStock       LigneMiseEnStockAchat[]  @relation("PutawayDestination")
  lignesRetourFournisseur LigneRetourFournisseur[] @relation("RetourSource")

  @@unique([boutiqueId, code])
  @@index([reseau, usage])
  @@map("entrepot")
}

// ---------------------------------------------------------------------------
// Utilisateurs et rôles (§4, §6.2)
// ---------------------------------------------------------------------------

model Role {
  id                 String                  @id @default(uuid())
  libelle            String                  @unique
  niveauHabilitation Int
  utilisateurs       Utilisateur[]
  reglesApprobation  RegleApprobationAchat[]

  @@map("role")
}

model Utilisateur {
  id           String    @id @default(uuid())
  nom          String
  prenom       String
  login        String    @unique
  passwordHash String
  role         Role      @relation(fields: [roleId], references: [id])
  roleId       String
  // Périmètre de données : null pour les profils à vue consolidée réseau
  // (Direction Générale, DAF, Caissier Central, Contrôle interne — §6.2)
  boutique     Boutique? @relation(fields: [boutiqueId], references: [id])
  boutiqueId   String?
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // Contact pour les notifications proactives (§6.7, §5.1) : optionnel,
  // aucune valeur par défaut inventée — sans contact renseigné, l'utilisateur
  // ne reçoit que la diffusion temps réel (WebSocket), pas de SMS/email.
  email     String?
  telephone String?

  // Sécurité authentification (§6.7)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  transactionsInitiees    TransactionCaisse[]    @relation("Initiateur")
  receptionsValidees      ReceptionValidation[]  @relation("Validateur")
  regularisationsValidees RegularisationLitige[] @relation("ValidateurRegularisation")
  entreesAudit            JournalAudit[]

  sessionsOuvertes           SessionCaisse[]                  @relation("OuvertureSession")
  sessionsTemoinOuverture    SessionCaisse[]                  @relation("OuvertureTemoin")
  sessionsFermees            SessionCaisse[]                  @relation("ClotureSession")
  sessionsTemoinCloture      SessionCaisse[]                  @relation("ClotureTemoin")
  receptionsStock            ReceptionStock[]
  mouvementsStock            MouvementStock[]
  retoursVente               RetourVente[]
  campagnesCreees            CampagneCrm[]
  devisClientsCrees          DevisClient[]
  facturesClientCrees        FactureClient[]              @relation("FactureClientCreateur")
  facturesClientEmises       FactureClient[]              @relation("FactureClientEmission")
  paiementsFactureClient     PaiementFactureClient[]
  sessionsInventaireInitiees SessionInventaire[]              @relation("InventaireInitiateur")
  sessionsInventaireValidees SessionInventaire[]              @relation("InventaireValidateur")
  commandesAchatInitiees     CommandeAchat[]                  @relation("CommandeAchatInitiateur")
  commandesAchatApprouvees   CommandeAchat[]                  @relation("CommandeAchatApprobateur")
  demandesAchatInitiees      DemandeAchat[]                   @relation("DemandeAchatInitiateur")
  demandesAchatApprouvees    DemandeAchat[]                   @relation("DemandeAchatApprobateur")
  consultationsAchatCreees   ConsultationFournisseur[]        @relation("ConsultationAchatCreateur")
  offresFournisseurSaisies   OffreFournisseur[]               @relation("OffreFournisseurSaisie")
  mouvementsBudgetAchat      MouvementBudgetAchat[]
  delegationsAccordees       DelegationApprobationAchat[]     @relation("DelegationApprobationDelegant")
  delegationsRecues          DelegationApprobationAchat[]     @relation("DelegationApprobationDelegataire")
  facturesFournisseur        FactureFournisseur[]
  paiementsFournisseur       PaiementFournisseur[]
  bonsStockInitiees          BonStock[]                       @relation("BonStockInitiateur")
  lotsCrees                  Lot[]
  receptionsAchats           ReceptionAchat[]                 @relation("ReceptionnaireAchat")
  decisionsQualiteAchats     DecisionQualiteAchat[]           @relation("ControleurQualiteAchat")
  misesEnStockAchats         MiseEnStockAchat[]               @relation("PutawayAchat")
  retoursFournisseurAchats   RetourFournisseur[]              @relation("RetourFournisseurCreateur")
  cloturesCourtesAchats      ClotureCourteAchat[]             @relation("ClotureCourteApprobateur")
  exceptionsFactureAchats    ExceptionRapprochementFacture[]  @relation("ExceptionFactureDecideur")
  revuesExtractionFactures   RevueExtractionFacture[]         @relation("RevueExtractionFactureAuteur")
  ecrituresComptables        EcritureComptable[]              @relation("EcritureComptableAuteur")
  propositionsPaiement       PropositionPaiementFournisseur[] @relation("PropositionPaiementPreparateur")
  paiementsApprouves         PropositionPaiementFournisseur[] @relation("PropositionPaiementApprobateur")
  paiementsExceptionnels     PropositionPaiementFournisseur[] @relation("PropositionPaiementException")
  paiementsExecutes          PropositionPaiementFournisseur[] @relation("PropositionPaiementExecuteur")
  rapprochementsBancaires    RapprochementBancaire[]          @relation("RapprochementBancaireAuteur")
  evidencesP2pDeposees        EvidenceP2p[]                    @relation("EvidenceP2pUploader")
  challengesActionSensible   ChallengeActionSensible[]
  filesEcritureComptable     FileEcritureComptable[]   @relation("FileEcritureAuteur")
  immobilisationsCreees      Immobilisation[]          @relation("ImmobilisationAuteur")

  @@map("utilisateur")
}

enum PurposeActionSensible {
  P2P_INVOICE_POST
  P2P_PAYMENT_APPROVE
  P2P_PAYMENT_EXCEPTION_APPROVE
  P2P_PAYMENT_EXECUTE
  ACCOUNTING_AI_POLICY_CREATE
  ACCOUNTING_AI_POLICY_APPROVE
}

// Jeton opaque, très court et à usage unique. Le mot de passe n'est jamais
// conservé ; seule la preuve de ré-authentification et sa consommation le sont.
model ChallengeActionSensible {
  id            String                 @id @default(uuid())
  utilisateur   Utilisateur            @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  purpose       PurposeActionSensible
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime               @default(now())

  @@index([utilisateurId, purpose, expiresAt, consumedAt])
  @@map("challenge_action_sensible")
}

// ---------------------------------------------------------------------------
// Caisses et trésorerie (§6.3.1, §6.4)
// ---------------------------------------------------------------------------

// Grande surface : TIROIR (poste POS) → MAGASIN (cash office) → CENTRALE.
enum TypeCaisse {
  TIROIR
  MAGASIN
  CENTRALE
}

model Caisse {
  id             String     @id @default(uuid())
  type           TypeCaisse
  // Colonne de cache en lecture seule : recalculée exclusivement à partir du
  // journal des TransactionCaisse (grand livre append-only — voir CLAUDE.md).
  // Ne jamais écrire directement via UPDATE ; toujours passer par le service
  // de recalcul du solde.
  soldeCourant   Decimal    @default(0) @db.Decimal(14, 2)
  boutique       Boutique?  @relation(fields: [boutiqueId], references: [id])
  boutiqueId     String?
  // Config tiroirs (DAF) — null pour MAGASIN / CENTRALE.
  code           String?
  libelle        String?
  actif          Boolean    @default(true)
  ordreAffichage Int        @default(0)

  transactions TransactionCaisse[]
  ventes       Vente[]
  sessions     SessionCaisse[]

  @@unique([boutiqueId, code])
  @@index([boutiqueId, type])
  @@map("caisse")
}

enum TypeTransaction {
  VENTE
  SORTIE_FONDS
  // Transfert tiroir ↔ magasin (hors circuit convoyeur §6.4).
  TRANSFERT_INTERNE
}

// Machine à états stricte — §6.4 du cahier des charges.
// INITIEE -> EN_TRANSIT -> RECEPTIONNEE -> VALIDEE
//                                       -> LITIGE -> VALIDEE (régularisation)
enum StatutTransaction {
  INITIEE
  EN_TRANSIT
  RECEPTIONNEE
  VALIDEE
  LITIGE
}

model TransactionCaisse {
  id           String            @id @default(uuid())
  type         TypeTransaction
  montant      Decimal           @db.Decimal(14, 2)
  dateHeure    DateTime          @default(now())
  statut       StatutTransaction @default(INITIEE)
  caisse       Caisse            @relation(fields: [caisseId], references: [id])
  caisseId     String
  initiateur   Utilisateur       @relation("Initiateur", fields: [initiateurId], references: [id])
  initiateurId String

  // Contrepartie miroir : SORTIE_FONDS → CENTRALE, ou TRANSFERT_INTERNE
  // tiroir ↔ magasin. Unique : une seule contrepartie par source.
  transactionSource   TransactionCaisse?  @relation("ContrepartieCentrale", fields: [transactionSourceId], references: [id])
  transactionSourceId String?             @unique
  contreparties       TransactionCaisse[] @relation("ContrepartieCentrale")

  // Clé d'idempotence pour le mode hors-ligne (§6.7) : une opération
  // rejouée à la reconnexion ne crée pas de doublon.
  clientOperationId String? @unique

  bordereau      BordereauVersement?
  sessionRemiseMagasin  SessionCaisse? @relation("SessionRemiseMagasin")
  sessionSortieCentrale SessionCaisse? @relation("SessionSortieCentrale")
  regularisation RegularisationLitige?

  @@index([caisseId])
  @@index([statut])
  @@map("transaction_caisse")
}

model BordereauVersement {
  id             String            @id @default(uuid())
  transaction    TransactionCaisse @relation(fields: [transactionId], references: [id])
  transactionId  String            @unique
  montantDeclare Decimal           @db.Decimal(14, 2)
  dateEmission   DateTime          @default(now())
  pieceJointe    String?

  reception ReceptionValidation?

  @@map("bordereau_versement")
}

model ReceptionValidation {
  id            String             @id @default(uuid())
  bordereau     BordereauVersement @relation(fields: [bordereauId], references: [id])
  bordereauId   String             @unique
  montantRecu   Decimal            @db.Decimal(14, 2)
  ecart         Decimal            @db.Decimal(14, 2)
  statutFinal   StatutTransaction
  validateur    Utilisateur        @relation("Validateur", fields: [validateurId], references: [id])
  validateurId  String
  dateReception DateTime           @default(now())

  @@map("reception_validation")
}

// Écriture compensatoire d'une régularisation de LITIGE (§6.4). Ne modifie
// jamais la TransactionCaisse ni la ReceptionValidation d'origine — le
// montant déclaré/constaté reste un fait historique immuable, seule cette
// table trace la décision d'arbitrage (montant retenu, motif, validateur).
model RegularisationLitige {
  id                 String            @id @default(uuid())
  transaction        TransactionCaisse @relation(fields: [transactionId], references: [id])
  transactionId      String            @unique
  montantRetenu      Decimal           @db.Decimal(14, 2)
  motif              String
  validateur         Utilisateur       @relation("ValidateurRegularisation", fields: [validateurId], references: [id])
  validateurId       String
  dateRegularisation DateTime          @default(now())

  @@map("regularisation_litige")
}

// ---------------------------------------------------------------------------
// Ventes / Point de vente boutique (§6.3.2, §5.1)
// ---------------------------------------------------------------------------

model Produit {
  id                       String                      @id @default(uuid())
  designation              String
  // Référence interne / SKU — unique si renseignée (NULL autorisé plusieurs
  // fois). Sert au POS et à la recherche catalogue (§6.3.2).
  reference                String?                     @unique
  // Classification libre (Protection, Charge, Audio…) — pas d'enum figé :
  // le cahier des charges ne prescrit pas de nomenclature.
  categorie                String?
  description              String?
  // Photo catalogue (data URL compressée ou URL). Optionnelle — le POS et
  // la fiche affichent les initiales si absente.
  imageUrl                 String?
  // Galerie boutique : JSON array de URLs (couverture = imageUrl).
  imagesUrls               String?                     @db.Text
  // Désactivation sans suppression : l'historique des ventes reste intact
  // (cohérent avec le grand livre append-only). Un produit inactif ne peut
  // plus être encaissé et n'alimente plus l'alerte STOCK_BAS.
  actif                    Boolean                     @default(true)
  // Article physique (stock décrémenté à la vente) ou prestation de service
  // (§6.3.1 « produits ou prestations... gestion de stock simplifiée si
  // nécessaire ») : une PRESTATION n'a pas de décrément/contrôle de stock.
  typeProduit              TypeProduit                 @default(ARTICLE)
  prixUnitaire             Decimal                     @db.Decimal(14, 2)
  // Canal e-commerce (PLAN-E-COMMERCE §3) — grille web distincte du POS.
  prixWeb                  Decimal?                    @db.Decimal(14, 2)
  visibleWeb               Boolean                     @default(false)
  tauxTva                  Decimal?                    @db.Decimal(5, 2)
  slug                     String?                     @unique
  // Cache réseau = somme(StockQuant.quantite). Ne jamais écrire à la
  // main — passer par StockService.
  stock                    Int                         @default(0)
  // Coût moyen pondéré (CMP) — recalculé à chaque réception fournisseur
  // (apps/api/src/fournisseurs/fournisseurs.service.ts). Sert de base à la
  // valorisation du stock (§ extension audit modules Odoo/QuickBooks).
  coutMoyenPondere         Decimal                     @default(0) @db.Decimal(14, 2)
  // Seuil de réapprovisionnement optionnel : déclenche l'alerte STOCK_BAS
  // (apps/api/src/alertes/alertes.service.ts) quand stock <= seuilReappro.
  seuilReappro             Int?
  codeBarres               String?                     @unique
  // true si codeBarres a été généré automatiquement (impression d'étiquettes
  // sans EAN fournisseur saisi) plutôt que saisi manuellement — distingue un
  // code interne d'un EAN réel (apps/api/src/produits/produits.service.ts).
  codeBarresGenere         Boolean                     @default(false)
  uniteMesure              String                      @default("UN")
  facteurUnite             Decimal                     @default(1) @db.Decimal(12, 4)
  parentId                 String?
  parent                   Produit?                    @relation("VarianteProduit", fields: [parentId], references: [id])
  variantes                Produit[]                   @relation("VarianteProduit")
  attributs                String?
  methodeCout              MethodeCout                 @default(CMP)
  coutStandard             Decimal                     @default(0) @db.Decimal(14, 2)
  strategieSortie          StrategieSortie             @default(FIFO)
  lignesVente              LigneVente[]
  lignesDevis              LigneDevisClient[]
  lignesFactureClient      LigneFactureClient[]
  receptions               ReceptionStock[]
  mouvements               MouvementStock[]
  quants                   StockQuant[]
  lignesInventaire         LigneInventaire[]
  lignesCommandeAchat      LigneCommandeAchat[]
  lignesDemandeAchat       LigneDemandeAchat[]
  lignesOffreAchat         LigneOffreFournisseur[]
  reservations             ReservationStock[]
  lots                     Lot[]
  stockLots                StockLot[]
  lignesBonStock           LigneBonStock[]
  reglesReappro            RegleReappro[]
  coutsLogistiques         CoutLogistique[]
  lignesReceptionAchat     LigneReceptionAchat[]
  lignesQualiteAchat       LigneDecisionQualiteAchat[]
  lignesMiseEnStockAchat   LigneMiseEnStockAchat[]
  lignesRetourFournisseur  LigneRetourFournisseur[]
  allocationsCoutReception AllocationCoutReception[]
  lignesCommandeWeb        LigneCommandeWeb[]
  reservationsWeb          ReservationWeb[]
  funnelEvents             ShopFunnelEvent[]

  @@index([categorie])
  @@index([actif])
  @@index([visibleWeb])
  @@map("produit")
}

// Grand livre append-only des mouvements de stock — même principe que
// TransactionCaisse pour la trésorerie (voir CLAUDE.md) : Produit.stock est
// un cache rapide, MouvementStock est la source de vérité auditable.
enum MethodeCout {
  CMP
  FIFO
  STANDARD
}

enum TypeProduit {
  ARTICLE
  PRESTATION
}

enum StrategieSortie {
  FIFO
  FEFO
}

enum TypeMouvementStock {
  RECEPTION
  VENTE
  RETOUR
  AJUSTEMENT
  TRANSFERT_OUT
  TRANSFERT_IN
  SCRAP
  RETOUR_FOURNISSEUR
}

model MouvementStock {
  id                     String                  @id @default(uuid())
  produit                Produit                 @relation(fields: [produitId], references: [id])
  produitId              String
  entrepot               Entrepot?               @relation(fields: [entrepotId], references: [id])
  // Nullable pour rétrocompatibilité des mouvements historiques (pré multi-emplacement).
  entrepotId             String?
  type                   TypeMouvementStock
  // Signé : positif = entrée, négatif = sortie (sur l'entrepôt ciblé)
  quantite               Int
  // Quantité du StockQuant après mouvement (pas le cache réseau Produit.stock)
  stockApres             Int
  reference              String?
  lot                    Lot?                    @relation(fields: [lotId], references: [id])
  lotId                  String?
  dateHeure              DateTime                @default(now())
  utilisateur            Utilisateur             @relation(fields: [utilisateurId], references: [id])
  utilisateurId          String
  ligneMiseEnStockAchat  LigneMiseEnStockAchat?
  ligneRetourFournisseur LigneRetourFournisseur?

  @@index([entrepotId, produitId])
  @@map("mouvement_stock")
}

// Quantité source de vérité par emplacement. Produit.stock = somme des quants
// (cache réseau recalculé, jamais écrit à la main).
model StockQuant {
  id           String   @id @default(uuid())
  produit      Produit  @relation(fields: [produitId], references: [id])
  produitId    String
  entrepot     Entrepot @relation(fields: [entrepotId], references: [id])
  entrepotId   String
  quantite     Int      @default(0)
  consignation Boolean  @default(false)

  @@unique([produitId, entrepotId])
  @@map("stock_quant")
}

model Lot {
  id                      String                   @id @default(uuid())
  produit                 Produit                  @relation(fields: [produitId], references: [id])
  produitId               String
  numero                  String
  dateExpiration          DateTime?
  createur                Utilisateur              @relation(fields: [createurId], references: [id])
  createurId              String
  createdAt               DateTime                 @default(now())
  stockLots               StockLot[]
  mouvements              MouvementStock[]
  lignesBon               LigneBonStock[]
  lignesReceptionAchat    LigneReceptionAchat[]
  lignesMiseEnStockAchat  LigneMiseEnStockAchat[]
  lignesRetourFournisseur LigneRetourFournisseur[]

  @@unique([produitId, numero])
  @@map("lot")
}

model StockLot {
  id         String   @id @default(uuid())
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  String
  entrepot   Entrepot @relation(fields: [entrepotId], references: [id])
  entrepotId String
  lot        Lot      @relation(fields: [lotId], references: [id])
  lotId      String
  quantite   Int      @default(0)

  @@unique([produitId, entrepotId, lotId])
  @@map("stock_lot")
}

enum TypeOperationStock {
  RECEPTION
  LIVRAISON
  TRANSFERT_INTERNE
  REBUT
}

enum StatutBonStock {
  BROUILLON
  PRET
  FAIT
  ANNULE
}

model BonStock {
  id               String             @id @default(uuid())
  numero           String             @unique
  type             TypeOperationStock
  statut           StatutBonStock     @default(BROUILLON)
  entrepotSource   Entrepot?          @relation("BonStockSource", fields: [entrepotSourceId], references: [id])
  entrepotSourceId String?
  entrepotDest     Entrepot?          @relation("BonStockDest", fields: [entrepotDestId], references: [id])
  entrepotDestId   String?
  notes            String?
  reception        ReceptionStock?    @relation(fields: [receptionId], references: [id])
  receptionId      String?
  initiateur       Utilisateur        @relation("BonStockInitiateur", fields: [initiateurId], references: [id])
  initiateurId     String
  dateCreation     DateTime           @default(now())
  datePret         DateTime?
  dateFait         DateTime?
  lignes           LigneBonStock[]

  @@index([statut, type])
  @@map("bon_stock")
}

model LigneBonStock {
  id             String    @id @default(uuid())
  bon            BonStock  @relation(fields: [bonId], references: [id])
  bonId          String
  produit        Produit   @relation(fields: [produitId], references: [id])
  produitId      String
  quantite       Int
  quantiteOk     Int?
  quantiteRebut  Int?
  lot            Lot?      @relation(fields: [lotId], references: [id])
  lotId          String?
  numeroLot      String?
  dateExpiration DateTime?

  @@map("ligne_bon_stock")
}

model RegleReappro {
  id         String   @id @default(uuid())
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  String
  entrepot   Entrepot @relation(fields: [entrepotId], references: [id])
  entrepotId String
  min        Int
  max        Int

  @@unique([produitId, entrepotId])
  @@map("regle_reappro")
}

model CoutLogistique {
  id            String          @id @default(uuid())
  produit       Produit         @relation(fields: [produitId], references: [id])
  produitId     String
  reception     ReceptionStock? @relation(fields: [receptionId], references: [id])
  receptionId   String?
  libelle       String
  montant       Decimal         @db.Decimal(14, 2)
  date          DateTime        @default(now())
  utilisateurId String

  @@index([produitId])
  @@map("cout_logistique")
}

// Inventaire physique — extension stock avancé (§6.5) pour la sécurité du
// stock : le comptage ne modifie pas StockQuant. Seule la validation par un
// autre utilisateur applique des AJUSTEMENT au grand livre (séparation des
// tâches, même esprit que le témoin de session de caisse §5.1).
enum StatutInventaire {
  EN_COURS
  VALIDE
  ANNULE
}

model SessionInventaire {
  id             String            @id @default(uuid())
  entrepot       Entrepot          @relation(fields: [entrepotId], references: [id])
  entrepotId     String
  statut         StatutInventaire  @default(EN_COURS)
  motif          String?
  dateOuverture  DateTime          @default(now())
  dateValidation DateTime?
  initiateur     Utilisateur       @relation("InventaireInitiateur", fields: [initiateurId], references: [id])
  initiateurId   String
  validateur     Utilisateur?      @relation("InventaireValidateur", fields: [validateurId], references: [id])
  validateurId   String?
  lignes         LigneInventaire[]

  @@index([entrepotId, statut])
  @@map("session_inventaire")
}

model LigneInventaire {
  id                String            @id @default(uuid())
  session           SessionInventaire @relation(fields: [sessionId], references: [id])
  sessionId         String
  produit           Produit           @relation(fields: [produitId], references: [id])
  produitId         String
  quantiteTheorique Int
  quantiteComptee   Int?
  dateComptage      DateTime?

  @@unique([sessionId, produitId])
  @@map("ligne_inventaire")
}

// ---------------------------------------------------------------------------
// Fournisseurs & approvisionnement — extension au socle MCD (§6.5), cycle
// complet validé avec l'utilisateur : fiche → bon de commande → réception
// → facture → paiement. Les paiements n'écrivent PAS dans TRANSACTION_CAISSE
// (§6.4, circuit versements boutique / caisse centrale).
// ---------------------------------------------------------------------------

enum StatutDemandeAchat {
  BROUILLON
  SOUMISE
  APPROUVEE
  REJETEE
  CONVERTIE
  ANNULEE
}

enum StatutCommandeAchat {
  BROUILLON
  SOUMISE_APPROBATION
  APPROUVEE
  REJETEE
  EN_PRODUCTION
  EXPEDIEE
  EN_TRANSIT
  EN_DOUANE
  DEDOUANEE
  CONFIRMEE
  PARTIELLEMENT_RECEPTIONNEE
  RECEPTIONNEE
  CLOTUREE
  ANNULEE
}

enum TypeEcheancePaiementAchat {
  ACOMPTE
  SOLDE
  LETTRE_CREDIT
  AUTRE
}

enum TypeJalonCommandeAchat {
  PRODUCTION_DEBUT
  PRODUCTION_FIN
  CHARGEMENT
  ETA
  ARRIVEE
}

enum ModeTransportInternational {
  MARITIME
  AERIEN
}

enum TypeCoutImport {
  DROIT_DOUANE
  TAXE
  FRET
  ASSURANCE
  SURESTARIE
  AUTRE
}

enum TypeDocumentImport {
  CONNAISSEMENT
  CERTIFICAT_ORIGINE
  DECLARATION_DOUANE
  PROFORMA
  AUTRE
}

enum StatutFactureFournisseur {
  BROUILLON
  COMPTABILISEE
  PARTIELLEMENT_PAYEE
  PAYEE
  ANNULEE
}

enum TypeDocumentFournisseur {
  FACTURE
  AVOIR
  STORNO
}

enum StatutRapprochementFacture {
  A_RAPPROCHER
  RAPPROCHEE
  LITIGE
  EXCEPTEE
}

enum StatutExtractionFacture {
  NON_REQUISE
  A_EXTRAIRE
  A_REVOIR
  REVUE
  REJETEE
}

enum DimensionLitigeFacture {
  QUANTITE
  PRIX_UNITAIRE
  TAXE
  DEVISE
  FOURNISSEUR
}

enum ModePaiementFournisseur {
  VIREMENT
  CHEQUE
  MOBILE_MONEY
  CAISSE_CENTRALE
  DEPOT
  COMPENSATION
  LETTRE_CREDIT
}

model Fournisseur {
  id                      String                              @id @default(uuid())
  nom                     String
  contact                 String?
  telephone               String?
  email                   String?
  adresse                 String?
  notes                   String?
  identifiantFiscal       String?
  pays                    String?
  devise                  String?
  conditionsPaiementJours Int?
  actif                   Boolean                             @default(true)
  createdAt               DateTime                            @default(now())
  receptions              ReceptionStock[]
  commandes               CommandeAchat[]
  factures                FactureFournisseur[]
  invitationsConsultation InvitationConsultationFournisseur[]
  offresAchat             OffreFournisseur[]
  receptionsAchats        ReceptionAchat[]
  retoursAchats           RetourFournisseur[]

  @@index([actif])
  @@map("fournisseur")
}

model CentreCout {
  id             String          @id @default(uuid())
  societe        Societe         @relation(fields: [societeId], references: [id])
  societeId      String
  code           String
  libelle        String
  actif          Boolean         @default(true)
  boutique       Boutique?       @relation(fields: [boutiqueId], references: [id])
  boutiqueId     String?
  demandesAchat  DemandeAchat[]
  commandesAchat CommandeAchat[]
  budgetsAchat   BudgetAchat[]

  @@unique([societeId, code])
  @@index([boutiqueId, actif])
  @@map("centre_cout")
}

model RegleApprobationAchat {
  id         String    @id @default(uuid())
  societe    Societe   @relation(fields: [societeId], references: [id])
  societeId  String
  niveau     Int
  montantMin Decimal   @db.Decimal(14, 2)
  montantMax Decimal?  @db.Decimal(14, 2)
  devise     String    @default("XOF")
  role       Role      @relation(fields: [roleId], references: [id])
  roleId     String
  actif      Boolean   @default(true)
  valideDu   DateTime  @default(now())
  valideAu   DateTime?

  @@index([societeId, actif, devise])
  @@map("regle_approbation_achat")
}

model DelegationApprobationAchat {
  id            String      @id @default(uuid())
  delegant      Utilisateur @relation("DelegationApprobationDelegant", fields: [delegantId], references: [id])
  delegantId    String
  delegataire   Utilisateur @relation("DelegationApprobationDelegataire", fields: [delegataireId], references: [id])
  delegataireId String
  roleLibelle   String
  valideDu      DateTime
  valideAu      DateTime
  actif         Boolean     @default(true)
  motif         String?

  @@index([delegantId, actif, valideDu, valideAu])
  @@index([delegataireId, actif, valideDu, valideAu])
  @@map("delegation_approbation_achat")
}

model DemandeAchat {
  id                String                    @id @default(uuid())
  numero            String                    @unique
  statut            StatutDemandeAchat        @default(BROUILLON)
  objet             String
  justification     String?
  montantEstime     Decimal?                  @db.Decimal(14, 2)
  devise            String                    @default("XOF")
  dateCreation      DateTime                  @default(now())
  dateSoumission    DateTime?
  dateDecision      DateTime?
  motifDecision     String?
  initiateur        Utilisateur               @relation("DemandeAchatInitiateur", fields: [initiateurId], references: [id])
  initiateurId      String
  approbateur       Utilisateur?              @relation("DemandeAchatApprobateur", fields: [approbateurId], references: [id])
  approbateurId     String?
  boutique          Boutique?                 @relation(fields: [boutiqueId], references: [id])
  boutiqueId        String?
  centreCout        CentreCout?               @relation(fields: [centreCoutId], references: [id])
  centreCoutId      String?
  clientOperationId String?                   @unique
  budget            BudgetAchat?              @relation(fields: [budgetId], references: [id])
  budgetId          String?
  lignes            LigneDemandeAchat[]
  commandes         CommandeAchat[]
  consultations     ConsultationFournisseur[]
  mouvementsBudget  MouvementBudgetAchat[]

  @@index([statut, dateCreation])
  @@index([boutiqueId, statut])
  @@index([budgetId, statut])
  @@map("demande_achat")
}

model LigneDemandeAchat {
  id          String                  @id @default(uuid())
  demande     DemandeAchat            @relation(fields: [demandeId], references: [id])
  demandeId   String
  produit     Produit?                @relation(fields: [produitId], references: [id])
  produitId   String?
  designation String
  quantite    Int
  prixEstime  Decimal?                @db.Decimal(14, 2)
  dateBesoin  DateTime?
  lignesOffre LigneOffreFournisseur[]

  @@index([demandeId])
  @@map("ligne_demande_achat")
}

enum TypeMouvementBudgetAchat {
  ENGAGEMENT
  LIBERATION
}

// Enveloppe configurée explicitement : aucun montant monétaire par défaut.
model BudgetAchat {
  id            String                 @id @default(uuid())
  centreCout    CentreCout             @relation(fields: [centreCoutId], references: [id])
  centreCoutId  String
  libelle       String
  devise        String
  montantAlloue Decimal                @db.Decimal(14, 2)
  dateDebut     DateTime
  dateFin       DateTime
  actif         Boolean                @default(true)
  demandes      DemandeAchat[]
  mouvements    MouvementBudgetAchat[]

  @@index([centreCoutId, actif, devise, dateDebut, dateFin])
  @@map("budget_achat")
}

// Grand livre append-only des engagements/libérations budgétaires.
model MouvementBudgetAchat {
  id            String                   @id @default(uuid())
  budget        BudgetAchat              @relation(fields: [budgetId], references: [id])
  budgetId      String
  demande       DemandeAchat             @relation(fields: [demandeId], references: [id])
  demandeId     String
  type          TypeMouvementBudgetAchat
  montant       Decimal                  @db.Decimal(14, 2)
  utilisateur   Utilisateur              @relation(fields: [utilisateurId], references: [id])
  utilisateurId String
  dateHeure     DateTime                 @default(now())
  motif         String?

  @@index([budgetId, dateHeure])
  @@index([demandeId, dateHeure])
  @@map("mouvement_budget_achat")
}

enum StatutConsultationFournisseur {
  OUVERTE
  CLOTUREE
  ANNULEE
}

model ConsultationFournisseur {
  id                String                              @id @default(uuid())
  numero            String                              @unique
  demande           DemandeAchat                        @relation(fields: [demandeId], references: [id])
  demandeId         String
  statut            StatutConsultationFournisseur       @default(OUVERTE)
  dateLimite        DateTime?
  notes             String?
  clientOperationId String?                             @unique
  createur          Utilisateur                         @relation("ConsultationAchatCreateur", fields: [createurId], references: [id])
  createurId        String
  dateCreation      DateTime                            @default(now())
  invitations       InvitationConsultationFournisseur[]
  offres            OffreFournisseur[]

  @@index([demandeId, statut])
  @@map("consultation_fournisseur")
}

model InvitationConsultationFournisseur {
  id             String                  @id @default(uuid())
  consultation   ConsultationFournisseur @relation(fields: [consultationId], references: [id])
  consultationId String
  fournisseur    Fournisseur             @relation(fields: [fournisseurId], references: [id])
  fournisseurId  String

  @@unique([consultationId, fournisseurId])
  @@map("invitation_consultation_fournisseur")
}

model OffreFournisseur {
  id                  String                  @id @default(uuid())
  consultation        ConsultationFournisseur @relation(fields: [consultationId], references: [id])
  consultationId      String
  fournisseur         Fournisseur             @relation(fields: [fournisseurId], references: [id])
  fournisseurId       String
  devise              String
  transport           Decimal                 @db.Decimal(14, 2)
  assurance           Decimal                 @db.Decimal(14, 2)
  douane              Decimal                 @db.Decimal(14, 2)
  taxes               Decimal                 @db.Decimal(14, 2)
  autresCouts         Decimal                 @db.Decimal(14, 2)
  delaiLivraisonJours Int
  conditionsPaiement  String?
  validiteJusquAu     DateTime?
  clientOperationId   String?                 @unique
  saisiePar           Utilisateur             @relation("OffreFournisseurSaisie", fields: [saisieParId], references: [id])
  saisieParId         String
  dateSoumission      DateTime                @default(now())
  lignes              LigneOffreFournisseur[]

  @@unique([consultationId, fournisseurId])
  @@index([consultationId, dateSoumission])
  @@map("offre_fournisseur")
}

model LigneOffreFournisseur {
  id             String            @id @default(uuid())
  offre          OffreFournisseur  @relation(fields: [offreId], references: [id])
  offreId        String
  ligneDemande   LigneDemandeAchat @relation(fields: [ligneDemandeId], references: [id])
  ligneDemandeId String
  produit        Produit?          @relation(fields: [produitId], references: [id])
  produitId      String?
  quantite       Int
  prixUnitaire   Decimal           @db.Decimal(14, 2)

  @@unique([offreId, ligneDemandeId])
  @@map("ligne_offre_fournisseur")
}

model CommandeAchat {
  id                   String                        @id @default(uuid())
  numero               String                        @unique
  fournisseur          Fournisseur                   @relation(fields: [fournisseurId], references: [id])
  fournisseurId        String
  statut               StatutCommandeAchat           @default(BROUILLON)
  devise               String                        @default("XOF")
  notes                String?
  dateCommande         DateTime                      @default(now())
  dateSoumission       DateTime?
  dateApprobation      DateTime?
  dateConfirmation     DateTime?
  dateCloture          DateTime?
  initiateur           Utilisateur                   @relation("CommandeAchatInitiateur", fields: [initiateurId], references: [id])
  initiateurId         String
  approbateur          Utilisateur?                  @relation("CommandeAchatApprobateur", fields: [approbateurId], references: [id])
  approbateurId        String?
  boutique             Boutique?                     @relation(fields: [boutiqueId], references: [id])
  boutiqueId           String?
  centreCout           CentreCout?                   @relation(fields: [centreCoutId], references: [id])
  centreCoutId         String?
  demande              DemandeAchat?                 @relation(fields: [demandeId], references: [id])
  demandeId            String?
  societe              Societe?                      @relation(fields: [societeId], references: [id])
  societeId            String?
  clientOperationId    String?                       @unique
  tauxChangeSnapshot   Decimal?                      @db.Decimal(18, 6)
  incoterm             String?
  lieuOrigine          String?
  lieuDestination      String?
  proformaReference    String?
  conditionsPaiement   String?
  versionCourante      Int                           @default(1)
  lignes               LigneCommandeAchat[]
  receptions           ReceptionStock[]
  versions             CommandeAchatVersion[]
  decisionsApprobation DecisionApprobationCommande[]
  echeancesPaiement    EcheancePaiementCommande[]
  jalons               JalonCommandeAchat[]
  expeditions          ExpeditionInternationale[]
  receptionsAchats     ReceptionAchat[]
  cloturesCourtes      ClotureCourteAchat[]

  @@index([fournisseurId, statut])
  @@index([demandeId])
  @@index([centreCoutId])
  @@index([societeId, dateCommande])
  @@map("commande_achat")
}

model LigneCommandeAchat {
  id                   String                    @id @default(uuid())
  commande             CommandeAchat             @relation(fields: [commandeId], references: [id])
  commandeId           String
  produit              Produit                   @relation(fields: [produitId], references: [id])
  produitId            String
  quantite             Int
  prixUnitaire         Decimal                   @db.Decimal(14, 2)
  receptions           ReceptionStock[]
  lignesReceptionAchat LigneReceptionAchat[]
  cloturesCourtes      LigneClotureCourteAchat[]
  tauxFiscalAchat      TauxFiscalAchat?          @relation(fields: [tauxFiscalAchatId], references: [id])
  tauxFiscalAchatId    String?
  codeTaxeSnapshot     String?
  tauxTaxeSnapshot     Decimal?                  @db.Decimal(7, 4)
  lignesFactureP2p     LigneFactureFournisseur[] @relation("LigneCommandeFactureP2P")

  @@unique([commandeId, produitId])
  @@map("ligne_commande_achat")
}

// Compteur transactionnel : l'UPDATE ... RETURNING de la migration attribue
// un numéro sans collision, même sous créations concurrentes.
model SequenceDocumentAchat {
  id              String  @id @default(uuid())
  societe         Societe @relation(fields: [societeId], references: [id])
  societeId       String
  exercice        Int
  typeDocument    String
  prochaineValeur Int     @default(1)

  @@unique([societeId, exercice, typeDocument])
  @@map("sequence_document_achat")
}

// Snapshots append-only. Une modification crée une nouvelle version ; aucune
// version publiée n'est mise à jour ou supprimée.
model CommandeAchatVersion {
  id                String        @id @default(uuid())
  commande          CommandeAchat @relation(fields: [commandeId], references: [id])
  commandeId        String
  version           Int
  motif             String?
  snapshot          Json
  creeParId         String
  dateCreation      DateTime      @default(now())
  clientOperationId String?       @unique

  @@unique([commandeId, version])
  @@map("commande_achat_version")
}

model DecisionApprobationCommande {
  id                String        @id @default(uuid())
  commande          CommandeAchat @relation(fields: [commandeId], references: [id])
  commandeId        String
  decision          String
  motif             String?
  approbateurId     String
  roleSnapshot      String
  dateDecision      DateTime      @default(now())
  clientOperationId String?       @unique

  @@index([commandeId, dateDecision])
  @@map("decision_approbation_commande")
}

model EcheancePaiementCommande {
  id          String                    @id @default(uuid())
  commande    CommandeAchat             @relation(fields: [commandeId], references: [id])
  commandeId  String
  type        TypeEcheancePaiementAchat
  ordre       Int
  pourcentage Decimal?                  @db.Decimal(7, 4)
  montant     Decimal?                  @db.Decimal(14, 2)
  datePrevue  DateTime?
  conditions  String?

  @@unique([commandeId, ordre])
  @@map("echeance_paiement_commande")
}

model JalonCommandeAchat {
  id                String                 @id @default(uuid())
  commande          CommandeAchat          @relation(fields: [commandeId], references: [id])
  commandeId        String
  type              TypeJalonCommandeAchat
  datePrevue        DateTime?
  dateReelle        DateTime?
  notes             String?
  creeParId         String
  dateCreation      DateTime               @default(now())
  clientOperationId String?                @unique

  @@index([commandeId, type])
  @@map("jalon_commande_achat")
}

model ExpeditionInternationale {
  id                  String                     @id @default(uuid())
  commande            CommandeAchat              @relation(fields: [commandeId], references: [id])
  commandeId          String
  mode                ModeTransportInternational
  referenceTransport  String
  transporteur        String?
  portAeroportDepart  String?
  portAeroportArrivee String?
  dateChargement      DateTime?
  eta                 DateTime?
  dateArrivee         DateTime?
  clientOperationId   String?                    @unique
  dateCreation        DateTime                   @default(now())
  conteneurs          ConteneurImport[]
  dossier             DossierDouane?
  receptionsAchats    ReceptionAchat[]

  @@index([commandeId, dateCreation])
  @@map("expedition_internationale")
}

model ConteneurImport {
  id           String                   @id @default(uuid())
  expedition   ExpeditionInternationale @relation(fields: [expeditionId], references: [id])
  expeditionId String
  numero       String
  type         String?
  plomb        String?

  @@unique([expeditionId, numero])
  @@map("conteneur_import")
}

model DossierDouane {
  id                String                   @id @default(uuid())
  expedition        ExpeditionInternationale @relation(fields: [expeditionId], references: [id])
  expeditionId      String                   @unique
  numeroDeclaration String?
  regimeDouanier    String?
  bureauDouane      String?
  dateDeclaration   DateTime?
  declarant         String?
  documents         DocumentImport[]
  couts             LigneCoutImport[]

  @@map("dossier_douane")
}

// Métadonnées seulement : aucun faux fichier ni contenu documentaire n'est
// créé. uri reste nullable tant qu'un document réel n'est pas déposé.
model DocumentImport {
  id                String             @id @default(uuid())
  dossier           DossierDouane      @relation(fields: [dossierId], references: [id])
  dossierId         String
  type              TypeDocumentImport
  reference         String
  dateDocument      DateTime?
  emetteur          String?
  nomFichier        String?
  mimeType          String?
  tailleOctets      Int?
  empreinteSha256   String?
  uri               String?
  clientOperationId String?            @unique
  dateCreation      DateTime           @default(now())

  @@index([dossierId, type])
  @@map("document_import")
}

enum TypeEvidenceP2p {
  RECEIPT
  QUALITY
  CUSTOMS
  INVOICE
}

// Le contenu binaire reste hors de toute racine statique. storageKey est
// généré par le serveur et ne contient jamais de nom ou chemin fourni par le
// client. Cette table porte les métadonnées d'intégrité et d'autorisation.
model EvidenceP2p {
  id              String          @id @default(uuid())
  type            TypeEvidenceP2p
  sourceId        String
  societe         Societe         @relation(fields: [societeId], references: [id])
  societeId       String
  boutique        Boutique?       @relation(fields: [boutiqueId], references: [id])
  boutiqueId      String?
  storageKey      String          @unique
  mimeType        String
  tailleOctets    Int
  empreinteSha256 String
  uploader        Utilisateur     @relation("EvidenceP2pUploader", fields: [uploaderId], references: [id])
  uploaderId      String
  dateCreation    DateTime        @default(now())

  @@index([type, sourceId])
  @@index([societeId, boutiqueId, dateCreation])
  @@map("evidence_p2p")
}

model LigneCoutImport {
  id                 String         @id @default(uuid())
  dossier            DossierDouane  @relation(fields: [dossierId], references: [id])
  dossierId          String
  type               TypeCoutImport
  libelle            String
  montant            Decimal        @db.Decimal(14, 2)
  devise             String
  tauxChangeSnapshot Decimal        @db.Decimal(18, 6)
  clientOperationId  String?        @unique
  dateCreation       DateTime       @default(now())

  @@index([dossierId, type])
  @@map("ligne_cout_import")
}

enum StatutReceptionAchat {
  QUANTITATIVE
  QUALITE_VALIDEE
  MISE_EN_STOCK
}

enum TypePreuveReception {
  DOCUMENT
  PHOTO
}

enum MethodeAllocationCout {
  VALEUR
  QUANTITE
  MANUELLE
}

enum StatutRetourFournisseur {
  PREPARE
  EXPEDIE
}

// Réception P2P multi-lignes. Le fait quantitatif est distinct de la décision
// qualité et n'écrit jamais dans le grand livre de stock.
model ReceptionAchat {
  id                       String                    @id @default(uuid())
  numero                   String                    @unique
  commande                 CommandeAchat             @relation(fields: [commandeId], references: [id])
  commandeId               String
  expedition               ExpeditionInternationale? @relation(fields: [expeditionId], references: [id])
  expeditionId             String?
  fournisseur              Fournisseur               @relation(fields: [fournisseurId], references: [id])
  fournisseurId            String
  statut                   StatutReceptionAchat      @default(QUANTITATIVE)
  referenceLivraison       String?
  emplacementQuarantaine   Entrepot                  @relation("ReceptionQuarantaine", fields: [emplacementQuarantaineId], references: [id])
  emplacementQuarantaineId String
  receptionnaire           Utilisateur               @relation("ReceptionnaireAchat", fields: [receptionnaireId], references: [id])
  receptionnaireId         String
  dateReception            DateTime                  @default(now())
  clientOperationId        String                    @unique
  lignes                   LigneReceptionAchat[]
  preuves                  PreuveReceptionAchat[]
  decisionQualite          DecisionQualiteAchat?
  miseEnStock              MiseEnStockAchat?
  charges                  ChargeCoutReception[]
  retours                  RetourFournisseur[]

  @@index([commandeId, dateReception])
  @@index([statut, dateReception])
  @@map("reception_achat")
}

model LigneReceptionAchat {
  id                   String                     @id @default(uuid())
  reception            ReceptionAchat             @relation(fields: [receptionId], references: [id])
  receptionId          String
  ligneCommande        LigneCommandeAchat         @relation(fields: [ligneCommandeId], references: [id])
  ligneCommandeId      String
  produit              Produit                    @relation(fields: [produitId], references: [id])
  produitId            String
  quantiteCommandee    Int
  quantiteRecue        Int
  prixUnitaireSnapshot Decimal                    @db.Decimal(14, 2)
  codeBarres           String?
  numeroLot            String?
  dateExpiration       DateTime?
  numerosSerie         Json?
  motifEcart           String?
  lot                  Lot?                       @relation(fields: [lotId], references: [id])
  lotId                String?
  decisionQualite      LigneDecisionQualiteAchat?
  lignesFactureP2p     LigneFactureFournisseur[]  @relation("LigneReceptionFactureP2P")

  @@unique([receptionId, ligneCommandeId])
  @@index([ligneCommandeId])
  @@map("ligne_reception_achat")
}

model PreuveReceptionAchat {
  id              String              @id @default(uuid())
  reception       ReceptionAchat      @relation(fields: [receptionId], references: [id])
  receptionId     String
  type            TypePreuveReception
  nomFichier      String
  mimeType        String
  tailleOctets    Int?
  empreinteSha256 String?
  uri             String
  dateCreation    DateTime            @default(now())

  @@index([receptionId, type])
  @@map("preuve_reception_achat")
}

// Décision indépendante, append-only : les rejets restent en quarantaine et
// seule la quantité acceptée pourra être mise en stock.
model DecisionQualiteAchat {
  id                String                      @id @default(uuid())
  reception         ReceptionAchat              @relation(fields: [receptionId], references: [id])
  receptionId       String                      @unique
  controleur        Utilisateur                 @relation("ControleurQualiteAchat", fields: [controleurId], references: [id])
  controleurId      String
  commentaire       String?
  dateDecision      DateTime                    @default(now())
  clientOperationId String                      @unique
  lignes            LigneDecisionQualiteAchat[]

  @@map("decision_qualite_achat")
}

model LigneDecisionQualiteAchat {
  id               String                    @id @default(uuid())
  decision         DecisionQualiteAchat      @relation(fields: [decisionId], references: [id])
  decisionId       String
  ligneReception   LigneReceptionAchat       @relation(fields: [ligneReceptionId], references: [id])
  ligneReceptionId String                    @unique
  produit          Produit                   @relation(fields: [produitId], references: [id])
  produitId        String
  quantiteAcceptee Int
  quantiteRejetee  Int
  motifRejet       String?
  misesEnStock     LigneMiseEnStockAchat[]
  allocations      AllocationCoutReception[]
  retours          LigneRetourFournisseur[]
  lignesFactureP2p LigneFactureFournisseur[] @relation("LigneQualiteFactureP2P")

  @@map("ligne_decision_qualite_achat")
}

model MiseEnStockAchat {
  id                String                  @id @default(uuid())
  reception         ReceptionAchat          @relation(fields: [receptionId], references: [id])
  receptionId       String                  @unique
  operateur         Utilisateur             @relation("PutawayAchat", fields: [operateurId], references: [id])
  operateurId       String
  dateMiseEnStock   DateTime                @default(now())
  clientOperationId String                  @unique
  lignes            LigneMiseEnStockAchat[]

  @@map("mise_en_stock_achat")
}

model LigneMiseEnStockAchat {
  id                String                    @id @default(uuid())
  miseEnStock       MiseEnStockAchat          @relation(fields: [miseEnStockId], references: [id])
  miseEnStockId     String
  ligneQualite      LigneDecisionQualiteAchat @relation(fields: [ligneQualiteId], references: [id])
  ligneQualiteId    String
  produit           Produit                   @relation(fields: [produitId], references: [id])
  produitId         String
  quantite          Int
  destination       Entrepot                  @relation("PutawayDestination", fields: [destinationId], references: [id])
  destinationId     String
  lot               Lot?                      @relation(fields: [lotId], references: [id])
  lotId             String?
  mouvement         MouvementStock            @relation(fields: [mouvementId], references: [id])
  mouvementId       String                    @unique
  coutUnitaireRendu Decimal                   @db.Decimal(14, 4)

  @@unique([miseEnStockId, ligneQualiteId])
  @@map("ligne_mise_en_stock_achat")
}

model ChargeCoutReception {
  id                String                    @id @default(uuid())
  reception         ReceptionAchat            @relation(fields: [receptionId], references: [id])
  receptionId       String
  libelle           String
  montant           Decimal                   @db.Decimal(14, 2)
  methode           MethodeAllocationCout
  clientOperationId String                    @unique
  dateAllocation    DateTime                  @default(now())
  allocations       AllocationCoutReception[]

  @@index([receptionId])
  @@map("charge_cout_reception")
}

model AllocationCoutReception {
  id             String                    @id @default(uuid())
  charge         ChargeCoutReception       @relation(fields: [chargeId], references: [id])
  chargeId       String
  ligneQualite   LigneDecisionQualiteAchat @relation(fields: [ligneQualiteId], references: [id])
  ligneQualiteId String
  produit        Produit                   @relation(fields: [produitId], references: [id])
  produitId      String
  montant        Decimal                   @db.Decimal(14, 2)

  @@unique([chargeId, ligneQualiteId])
  @@map("allocation_cout_reception")
}

model RetourFournisseur {
  id                    String                   @id @default(uuid())
  numero                String                   @unique
  reception             ReceptionAchat           @relation(fields: [receptionId], references: [id])
  receptionId           String
  fournisseur           Fournisseur              @relation(fields: [fournisseurId], references: [id])
  fournisseurId         String
  statut                StatutRetourFournisseur  @default(PREPARE)
  referenceRma          String?
  motif                 String
  reclamationQualite    String?
  avoirAttendu          Boolean                  @default(false)
  montantAvoirAttendu   Decimal?                 @db.Decimal(14, 2)
  createur              Utilisateur              @relation("RetourFournisseurCreateur", fields: [createurId], references: [id])
  createurId            String
  dateCreation          DateTime                 @default(now())
  dateExpedition        DateTime?
  clientOperationId     String                   @unique
  expeditionOperationId String?                  @unique
  lignes                LigneRetourFournisseur[]

  @@index([receptionId, statut])
  @@map("retour_fournisseur")
}

model LigneRetourFournisseur {
  id             String                    @id @default(uuid())
  retour         RetourFournisseur         @relation(fields: [retourId], references: [id])
  retourId       String
  ligneQualite   LigneDecisionQualiteAchat @relation(fields: [ligneQualiteId], references: [id])
  ligneQualiteId String
  produit        Produit                   @relation(fields: [produitId], references: [id])
  produitId      String
  quantite       Int
  depuisStock    Boolean                   @default(true)
  source         Entrepot                  @relation("RetourSource", fields: [sourceId], references: [id])
  sourceId       String
  lot            Lot?                      @relation(fields: [lotId], references: [id])
  lotId          String?
  mouvement      MouvementStock?           @relation(fields: [mouvementId], references: [id])
  mouvementId    String?                   @unique

  @@unique([retourId, ligneQualiteId])
  @@map("ligne_retour_fournisseur")
}

model ClotureCourteAchat {
  id                String                    @id @default(uuid())
  commande          CommandeAchat             @relation(fields: [commandeId], references: [id])
  commandeId        String
  motif             String
  approbateur       Utilisateur               @relation("ClotureCourteApprobateur", fields: [approbateurId], references: [id])
  approbateurId     String
  roleSnapshot      String
  dateApprobation   DateTime                  @default(now())
  clientOperationId String                    @unique
  lignes            LigneClotureCourteAchat[]

  @@index([commandeId, dateApprobation])
  @@map("cloture_courte_achat")
}

model LigneClotureCourteAchat {
  id              String             @id @default(uuid())
  cloture         ClotureCourteAchat @relation(fields: [clotureId], references: [id])
  clotureId       String
  ligneCommande   LigneCommandeAchat @relation(fields: [ligneCommandeId], references: [id])
  ligneCommandeId String
  quantiteAnnulee Int
  motif           String

  @@unique([clotureId, ligneCommandeId])
  @@map("ligne_cloture_courte_achat")
}

// Réception de stock : incrémente Produit.stock de façon atomique (même
// principe que le décrément lors d'une vente — voir ventes.service.ts).
model ReceptionStock {
  id               String                   @id @default(uuid())
  produit          Produit                  @relation(fields: [produitId], references: [id])
  produitId        String
  fournisseur      Fournisseur              @relation(fields: [fournisseurId], references: [id])
  fournisseurId    String
  quantite         Int
  // Prix d'achat unitaire réel — alimente le recalcul du coût moyen pondéré
  // (Produit.coutMoyenPondere) et l'historique des prix par fournisseur.
  prixAchat        Decimal                  @db.Decimal(14, 2)
  dateReception    DateTime                 @default(now())
  utilisateur      Utilisateur              @relation(fields: [utilisateurId], references: [id])
  utilisateurId    String
  // Emplacement réellement crédité (grand livre MouvementStock). Nullable
  // pour les réceptions historiques antérieures à ce suivi.
  entrepot         Entrepot?                @relation(fields: [entrepotId], references: [id])
  entrepotId       String?
  // Référence de livraison (BL).
  reference        String?
  commande         CommandeAchat?           @relation(fields: [commandeId], references: [id])
  commandeId       String?
  ligneCommande    LigneCommandeAchat?      @relation(fields: [ligneCommandeId], references: [id])
  ligneCommandeId  String?
  ligneFacture     LigneFactureFournisseur?
  bonsStock        BonStock[]
  coutsLogistiques CoutLogistique[]

  @@index([fournisseurId, dateReception])
  @@index([commandeId])
  @@map("reception_stock")
}

enum NatureFactureFournisseur {
  MARCHANDISE
  CHARGE
}

model FactureFournisseur {
  id                          String                          @id @default(uuid())
  numero                      String                          @unique
  referenceFournisseur        String?
  referenceNormalisee         String?
  societe                     Societe                         @relation(fields: [societeId], references: [id])
  societeId                   String
  nature                      NatureFactureFournisseur        @default(MARCHANDISE)
  fournisseur                 Fournisseur                     @relation(fields: [fournisseurId], references: [id])
  fournisseurId               String
  statut                      StatutFactureFournisseur        @default(BROUILLON)
  statutRapprochement         StatutRapprochementFacture      @default(A_RAPPROCHER)
  statutExtraction            StatutExtractionFacture         @default(NON_REQUISE)
  typeDocument                TypeDocumentFournisseur         @default(FACTURE)
  dateFacture                 DateTime                        @default(now())
  dateDocument                DateTime?
  dateEcheance                DateTime?
  notes                       String?
  devise                      String                          @default("XOF")
  tauxChangeSnapshot          Decimal?                        @db.Decimal(18, 6)
  montant                     Decimal                         @db.Decimal(14, 2)
  montantBrutHt               Decimal?                        @db.Decimal(14, 2)
  remiseLignes                Decimal?                        @db.Decimal(14, 2)
  remiseGlobale               Decimal?                        @db.Decimal(14, 2)
  totalHt                     Decimal?                        @db.Decimal(14, 2)
  totalTaxes                  Decimal?                        @db.Decimal(14, 2)
  totalRetenues               Decimal?                        @db.Decimal(14, 2)
  totalTtc                    Decimal?                        @db.Decimal(14, 2)
  netAPayer                   Decimal?                        @db.Decimal(14, 2)
  documentHash                String?                         @unique
  documentNomFichier          String?
  documentMimeType            String?
  documentTailleOctets        Int?
  documentUri                 String?
  documentMetadata            Json?
  extractionPayload           Json?
  clientOperationId           String?                         @unique
  operationComptabilisationId String?                         @unique
  createur                    Utilisateur                     @relation(fields: [createurId], references: [id])
  createurId                  String
  factureOrigine              FactureFournisseur?             @relation("CompensationFacture", fields: [factureOrigineId], references: [id])
  factureOrigineId            String?
  compensations               FactureFournisseur[]            @relation("CompensationFacture")
  motifCompensation           String?
  lignes                      LigneFactureFournisseur[]
  taxes                       TaxeFactureFournisseur[]
  litiges                     LitigeRapprochementFacture[]
  exceptions                  ExceptionRapprochementFacture[]
  revuesExtraction            RevueExtractionFacture[]
  paiements                   PaiementFournisseur[]
  echeancesPaiement           EcheancePaiementFournisseur[]
  allocationsPaiement         AllocationPaiementFournisseur[]
  ecrituresComptables         EcritureComptable[]

  @@unique([fournisseurId, referenceNormalisee])
  @@index([fournisseurId, dateDocument, montant])
  @@index([fournisseurId, statut])
  @@index([statutRapprochement, statut])
  @@index([societeId, nature, statut])
  @@map("facture_fournisseur")
}

model LigneFactureFournisseur {
  id                         String                     @id @default(uuid())
  facture                    FactureFournisseur         @relation(fields: [factureId], references: [id])
  factureId                  String
  reception                  ReceptionStock?            @relation(fields: [receptionId], references: [id])
  receptionId                String?                    @unique
  ligneCommande              LigneCommandeAchat?        @relation("LigneCommandeFactureP2P", fields: [ligneCommandeId], references: [id])
  ligneCommandeId            String?
  ligneReception             LigneReceptionAchat?       @relation("LigneReceptionFactureP2P", fields: [ligneReceptionId], references: [id])
  ligneReceptionId           String?
  ligneQualite               LigneDecisionQualiteAchat? @relation("LigneQualiteFactureP2P", fields: [ligneQualiteId], references: [id])
  ligneQualiteId             String?
  natureDepense              NatureDepense?             @relation(fields: [natureDepenseId], references: [id])
  natureDepenseId            String?
  libelle                    String?
  produitId                  String?
  quantite                   Int
  prixUnitaire               Decimal                    @db.Decimal(14, 2)
  montantBrut                Decimal?                   @db.Decimal(14, 2)
  remise                     Decimal?                   @db.Decimal(14, 2)
  montantHt                  Decimal?                   @db.Decimal(14, 2)
  tauxFiscalAchat            TauxFiscalAchat?           @relation(fields: [tauxFiscalAchatId], references: [id])
  tauxFiscalAchatId          String?
  referentielCodeSnapshot    String?
  referentielVersionSnapshot Int?
  codeTaxeSnapshot           String?
  typeTaxeSnapshot           TypeTaxeAchat?
  tauxTaxeSnapshot           Decimal?                   @db.Decimal(7, 4)
  montantTaxe                Decimal?                   @db.Decimal(14, 2)
  taxes                      TaxeFactureFournisseur[]

  @@unique([factureId, ligneCommandeId, ligneQualiteId])
  @@index([ligneCommandeId])
  @@index([ligneQualiteId])
  @@index([natureDepenseId])
  @@map("ligne_facture_fournisseur")
}

model TaxeFactureFournisseur {
  id                         String                   @id @default(uuid())
  facture                    FactureFournisseur       @relation(fields: [factureId], references: [id])
  factureId                  String
  ligne                      LigneFactureFournisseur? @relation(fields: [ligneId], references: [id])
  ligneId                    String?
  tauxFiscalAchat            TauxFiscalAchat?         @relation(fields: [tauxFiscalAchatId], references: [id])
  tauxFiscalAchatId          String?
  referentielCodeSnapshot    String
  referentielVersionSnapshot Int
  codeSnapshot               String
  libelleSnapshot            String
  typeSnapshot               TypeTaxeAchat
  tauxSnapshot               Decimal                  @db.Decimal(7, 4)
  base                       Decimal                  @db.Decimal(14, 2)
  montant                    Decimal                  @db.Decimal(14, 2)

  @@index([factureId, typeSnapshot])
  @@map("taxe_facture_fournisseur")
}

model LitigeRapprochementFacture {
  id           String                 @id @default(uuid())
  facture      FactureFournisseur     @relation(fields: [factureId], references: [id])
  factureId    String
  ligneId      String?
