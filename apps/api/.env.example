DATABASE_URL="postgresql://caisse@127.0.0.1:5433/caisse_crm?schema=public"
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32"

# Cloudflare Turnstile (anti-bots sur POST /auth/login).
# Absente = pas de contrôle (local / e2e). Présente = token obligatoire.
# Créer un widget : Cloudflare Dashboard → Turnstile → Add site
#   Domaines : crm.majorautoparts.shop, pos.majorautoparts.shop, localhost
# TURNSTILE_SECRET_KEY=0x4AAAAA...

# Production — origines CORS explicites (mobile, outils). Vide + NODE_ENV=production = CORS fermé.
# CORS_ORIGINS="https://caisse.example.com"

# Campagnes / alertes (optionnel)
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Shop e-mails (Resend) — laisser mock en local ; activer au staging/prod
# EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# SHOP_EMAIL_FROM="MAJOR AUTO PARTS <noreply@votre-domaine.com>"
# SHOP_ADMIN_EMAIL=admin@votre-domaine.com
# SHOP_PUBLIC_URL=http://127.0.0.1:5174
# STAFF_EMAIL_FROM="MAJOR AUTO PARTS <shop-majorautoparts@prodestic.net>"
# STAFF_BRIEFING_ENABLED=false
# CRM_PUBLIC_URL=http://127.0.0.1:5173

# Paiements shop (Paystack live en prod). Hors production, un sandbox local
# encaisse la commande si la clé est absente — jamais en production.
# PAYSTACK_SECRET_KEY=sk_live_ou_sk_test
# SHOP_PSP_SANDBOX=1
# ORANGE_MONEY_ENABLED=1
# WAVE_ENABLED=1

# Optionnel — uniquement pour backfill one-shot des anciennes fiches AES-GCM.
# Retirer après démarrage réussi sans warning « encore chiffrée(s) ».
# CLIENT_DATA_ENCRYPTION_KEY="change-me-generate-with-openssl-rand-hex-32"
