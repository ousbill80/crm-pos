# Copier vers .env.prod à la racine — ne jamais committer .env.prod
#
# Génération secrets :
#   openssl rand -hex 32

# --- PostgreSQL (service db, réseau interne uniquement) ---
POSTGRES_USER=caisse
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_DB=caisse_crm

# --- API ---
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Origines CORS explicites pour le client mobile / outils externes.
# Le web en prod passe par la passerelle (same-origin) : laisser vide si seul le web est utilisé.
# Hostinger MAJOR : https://crm.majorautoparts.shop,https://pos.majorautoparts.shop
CORS_ORIGINS=

# --- Passerelle ---
# 127.0.0.1 = uniquement Caddy / localhost (recommandé VPS).
# 0.0.0.0 = exposition publique — uniquement avec TLS_ENABLED=1, jamais HTTP clair.
GATEWAY_BIND=127.0.0.1
# Derrière Caddy : HTTP_PORT=8081 (voir DEPLOIEMENT-HOSTINGER.md)
HTTP_PORT=8081
HTTPS_PORT=8443
# 1 = TLS terminé sur nginx (certificats dans deploy/certs/) — laisser 0 derrière Caddy
TLS_ENABLED=0
TLS_CERTS_DIR=./deploy/certs

# --- Campagnes / alertes (optionnel — sinon export CSV) ---
# SMS_GATEWAY_URL=https://sms-provider.example/send
# SMS_GATEWAY_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# ALERTES_INTERVALLE_MINUTES=15
