# Caddy — HTTPS. Derrière Cloudflare (proxy orange) : IP d’origine cachée.
#
#   cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Plages Cloudflare = trusted_proxies (IP client réelle pour le rate-limit).
# UA IA : 403 même si une règle WAF Cloudflare est oubliée.

{
	email admin@majorautoparts.shop
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	encode gzip
}

# GPTBot, ClaudeBot, Common Crawl, Bytespider, Google-Extended, etc.
(block_ai_crawlers) {
	@ai_bot header_regexp User-Agent (?i)(GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|Anthropic-AI|Google-Extended|Google-CloudVertexBot|Bytespider|CCBot|Amazonbot|Applebot-Extended|meta-externalagent|PerplexityBot|YouBot|Diffbot|cohere-ai|AI2Bot|PetalBot|omgili|TimpiBot|ImagesiftBot|iaskspider|DuckAssistBot)
	respond @ai_bot 403
}

# CRM / POS / staging : aucun index, aucun crawler.
(block_all_crawlers) {
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noai, noimageai"
	@any_crawler header_regexp User-Agent (?i)(bot|crawler|spider|crawl|slurp|facebookexternalhit|facebookcatalog|WhatsApp)
	respond @any_crawler 403
}

(to_shop) {
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

(to_crm) {
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

# Boutique e-commerce (PWA) — SEO Google OK, IA non.
majorautoparts.shop, www.majorautoparts.shop {
	import security_headers
	import block_ai_crawlers
	header X-Robots-Tag "noai, noimageai"
	import to_shop
}

# Back-office Caisse / CRM — jamais indexé
crm.majorautoparts.shop {
	import security_headers
	import block_ai_crawlers
	import block_all_crawlers
	import to_crm
}

# POS boutique → même passerelle CRM, page /pos
pos.majorautoparts.shop {
	import security_headers
	import block_ai_crawlers
	import block_all_crawlers
	@root path /
	redir @root /pos permanent
	import to_crm
}

(staging_gate) {
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noai"
	# basic_auth {
	# 	major $$2a$$14$$REMPLACER
	# }
}

(to_shop_staging) {
	reverse_proxy 127.0.0.1:8082 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

(to_crm_staging) {
	reverse_proxy 127.0.0.1:8083 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
}

staging.majorautoparts.shop {
	import security_headers
	import block_ai_crawlers
	import block_all_crawlers
	import staging_gate
	import to_shop_staging
}

crm-staging.majorautoparts.shop {
	import security_headers
	import block_ai_crawlers
	import block_all_crawlers
	import staging_gate
	import to_crm_staging
}

pos-staging.majorautoparts.shop {
	import security_headers
	import block_ai_crawlers
	import block_all_crawlers
	@root path /
	redir @root /pos permanent
	import to_crm_staging
}
