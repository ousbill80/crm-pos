# Copier vers .env.staging — ne jamais committer .env.staging
#
#   cp .env.staging.example .env.staging
#   openssl rand -hex 24
#   openssl rand -hex 32

# --- PostgreSQL (volume isolé de la prod) ---
POSTGRES_USER=caisse
POSTGRES_PASSWORD=change-me-staging-db
POSTGRES_DB=caisse_crm_staging

# --- API monolith (CRM + shop, Option B staging) ---
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_SECRET_SHOP=change-me-generate-with-openssl-rand-hex-32
SHOP_PANIER_SECRET=change-me-generate-with-openssl-rand-hex-32

CORS_ORIGINS=https://crm-staging.majorautoparts.shop,https://pos-staging.majorautoparts.shop,https://staging.majorautoparts.shop
SHOP_PUBLIC_URL=https://staging.majorautoparts.shop

# Comptes démo (demo-dg / MotDePasse!123). Idempotent si déjà seedé.
SEED_ON_START=true

# Paiements sandbox uniquement — jamais les clés live
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
ORANGE_MONEY_ENABLED=0
WAVE_ENABLED=0
EMAIL_PROVIDER=mock

# Caddy → localhost
STAGING_BIND=127.0.0.1
STAGING_SHOP_PORT=8082
STAGING_CRM_PORT=8083
