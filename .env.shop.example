# Copier → .env.shop pour la stack boutique (DMZ)

# Base PostgreSQL partagée avec le CRM (obligatoire en prod).
# Mot de passe = POSTGRES_PASSWORD de .env.prod (stack caisse-crm-prod).
DATABASE_URL=postgresql://caisse:change-me-crm-db@caisse-crm-prod-db-1:5432/caisse_crm?schema=public
CRM_DOCKER_NETWORK=caisse-crm-prod_backend

# Uniquement pour dev isolé (--profile local-db) :
POSTGRES_USER=caisse
POSTGRES_PASSWORD=change-me-shop-db
POSTGRES_DB=caisse_crm

JWT_SECRET_SHOP=change-me-generate-with-openssl-rand-hex-32
SHOP_PANIER_SECRET=change-me-generate-with-openssl-rand-hex-32

# 127.0.0.1 = Caddy uniquement (recommandé). Ne pas mettre 0.0.0.0 sans TLS frontal.
SHOP_BIND=127.0.0.1
SHOP_HTTP_PORT=8080
SHOP_HTTPS_PORT=8443
# Hostinger : https://www.majorautoparts.shop,https://majorautoparts.shop
SHOP_CORS_ORIGINS=https://www.majorautoparts.shop,https://majorautoparts.shop
SHOP_PUBLIC_URL=https://www.majorautoparts.shop

PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
ORANGE_MONEY_ENABLED=0
WAVE_ENABLED=0

# E-mails cycle de vie (Resend) — credentials au go-live / staging
# Dev sans clé : EMAIL_PROVIDER=mock (journal console uniquement)
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# Domaine vérifié dans Resend (ou onboarding@resend.dev en test)
SHOP_EMAIL_FROM="MAJOR AUTO PARTS <majorautoparts@prodestic.net>"
SHOP_ADMIN_EMAIL=admin@majorautoparts.shop

TLS_ENABLED=0
TLS_CERTS_DIR=./deploy/certs-shop
